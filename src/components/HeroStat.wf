component HeroStat(label: String, value: String, unit: String, note: String, noteColor: String, bars: [Any], color: String) {
    Stack(data-interactive: "true") {
        style { gap: 12px; padding: 20px; background: $surface-raised; border: 1px solid $line-default; border-radius: $radius-md
                transition: border-color $d-base $ease-standard, box-shadow $d-base $ease-standard, transform $d-base $ease-standard
                &:hover { border-color: $line-strong; box-shadow: $shadow-md; transform: translateY(-2px) } }
        Overline(text: label)
        Row(align: .baseline) { style { flex-wrap: nowrap; gap: 8px }
            Num(text: value, size: "34px", weight: "500")
            Text(unit) { style { margin: 0; font-size: 13px; color: $text-tertiary } } }
        Row(align: .end) { style { flex-wrap: nowrap; gap: 4px; height: 30px; margin-top: auto; align-items: flex-end }
            for h in bars { Container { style { flex: 1 1 0; height: {h}%; min-height: 2px; background: {color}; opacity: 0.7; border-radius: 1px; padding: 0; margin: 0 } } } }
        Text(note) { style { margin: 0; font-size: 12px; color: {noteColor} } }
    }
}
