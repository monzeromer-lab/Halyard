Component FeatureCard (overline: String, title: String, body: String, link: String = "", to: String = "") {
    Stack(data-interactive: "true") {
        style {
            gap: "0"  padding: "24px"  background: "var(--surface-raised)"  border: "1px solid var(--line-default)"  border-radius: "var(--radius-md)"  height: "100%"
            transition: "border-color var(--d-base) var(--ease-standard), box-shadow var(--d-base) var(--ease-standard), transform var(--d-base) var(--ease-standard)"
            hover { border-color: "var(--line-strong)"  box-shadow: "var(--shadow-md)"  transform: "translateY(-2px)" }
        }
        Container { style { padding: "0 0 10px"  margin: "0"  width: "auto" }  Overline(text: overline) }
        Heading(title, h3) { style { margin: "0 0 8px"  font-size: "20px"  line-height: "1.3"  font-weight: "700"  letter-spacing: "-0.01em" } }
        Text(body) { style { margin: "0 0 14px"  font-size: "14px"  line-height: "1.55"  color: "var(--text-secondary)" } }
        if link != "" {
            Link(link, to: to) { style { font: "600 13px/1 var(--font-sans)"  color: "var(--text-brand)"  hover { color: "var(--brand-hover)" } } }
        }
    }
}
