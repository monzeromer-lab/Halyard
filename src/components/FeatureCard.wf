component FeatureCard(overline: String, title: String, body: String, link: String = "", to: String = "") {
    Stack(data-interactive: "true") {
        style {
            gap: 0; padding: 24px; background: $surface-raised; border: 1px solid $line-default; border-radius: $radius-md; height: 100%
            transition: border-color $d-base $ease-standard, box-shadow $d-base $ease-standard, transform $d-base $ease-standard
            &:hover { border-color: $line-strong; box-shadow: $shadow-md; transform: translateY(-2px) }
        }
        Container { style { padding: 0 0 10px; margin: 0; width: auto }  Overline(text: overline) }
        Heading(title).h3 { style { margin: 0 0 8px; font-size: 20px; line-height: 1.3; font-weight: 700; letter-spacing: -0.01em } }
        Text(body) { style { margin: 0 0 14px; font-size: 14px; line-height: 1.55; color: $text-secondary } }
        if link != "" {
            Link(link, to: to) { style { font: 600 13px/1 $font-sans; color: $text-brand; &:hover { color: $brand-hover } } }
        }
    }
}
