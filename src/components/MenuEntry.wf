// An item of a menu or palette: icon, label, an optional key hint.
Component MenuEntry (label: String, icon: String = "", hint: String = "", tone: String = "", role: String = "menuitem", selected: Bool = false) {
    derived fg = if tone == "danger" { "var(--text-danger)" } else { "var(--text-primary)" }
    derived bg = if selected { "var(--surface-active)" } else { "transparent" }
    derived sel = if role == "option" { selected } else { null }
    Button("", type: "button", role: role, aria-selected: sel, aria-label: label) {
        style {
            display: "flex"  align-items: "center"  gap: "10px"  width: "100%"  background: bg  border: "0"  padding: "9px 11px"  border-radius: "var(--radius-sm)"
            cursor: "pointer"  text-align: "left"  font: "500 13px/1.3 var(--font-sans)"  color: fg
            hover { background: "var(--surface-hover)" }
        }
        if icon != "" { Icon(icon) { style { display: "inline-flex"  flex: "none"  font-size: "14px"  color: "var(--text-tertiary)" } } }
        Text(label) { style { margin: "0"  flex-grow: "1"  font: "inherit"  color: "inherit" } }
        if hint != "" { Kbd(text: hint) }
    }
}
