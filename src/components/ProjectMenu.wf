// The project switcher menu, under the rail's project button.
component ProjectMenu {
    use UiStore
    if UiStore.menuOpen {
        Scrim(label: "Close the menu", dim: false).fadeIn.fast
        Stack(role: "menu", aria-label: "Projects").fadeIn.fast {
            style { position: fixed; left: 12px; top: 96px; width: 236px; z-index: 900; gap: 0; background: $surface-overlay; border: 1px solid $line-default; border-radius: $radius-md; padding: 6px; box-shadow: $shadow-md; @media (max-width: 768px) { left: 16px; top: 60px } }
            on keydown(event) { if event.key == "Escape" { UiStore.close() } }
            MenuEntry(label: "storefront-edge", icon: "check") { on click { UiStore.close() } }
            MenuEntry(label: "marketing-site") { on click { UiStore.close() } }
            MenuEntry(label: "internal-tools") { on click { UiStore.close() } }
            Container { style { padding: 5px 0; width: auto }  Rule }
            MenuEntry(label: "New project", icon: "plus") { on click { UiStore.close()  navigate("/new") } }
        }
    }
}
