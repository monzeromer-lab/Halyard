// A docs nav section: a disclosure button with a count, then its pages. The
// current page carries aria-current.
component TreeSection(name: String, count: String, open: Bool, items: [Any], current: String) {
    derived rot = if open { "rotate(90deg)" } else { "rotate(0deg)" }
    Stack {
        style { gap: 0; margin-bottom: 8px }
        Button("", type: "button", aria-expanded: open) {
            style { width: 100%; background: none; border: 0; display: flex; align-items: center; gap: 8px; padding: 8px; color: $text-primary
                    font: 700 12px/1.2 $font-sans; letter-spacing: 0.06em; cursor: pointer; text-transform: uppercase; border-radius: 6px; &:hover { background: $surface-hover } }
            Icon("chevron-right") { style { color: $text-tertiary; transform: {rot}; display: inline-flex; transition: transform $d-fast $ease-standard; font-size: 13px } }
            Text(name) { style { margin: 0; flex-grow: 1; text-align: left; font: inherit; color: inherit } }
            Num(text: count, size: "11px", color: "var(--text-disabled)")
        }
        if open {
            for item in items {
                if item == current {
                    Link(item, to: "/docs", aria-current: "page") { style { display: block; padding: 7px 10px 7px 26px; border-radius: 6px; font: 600 13px/1.4 $font-sans; background: $brand-soft; color: $text-brand; text-decoration: none } }
                } else {
                    Link(item, to: "/docs") { style { display: block; padding: 7px 10px 7px 26px; border-radius: 6px; font: 400 13px/1.4 $font-sans; color: $text-tertiary; text-decoration: none; &:hover { background: $surface-hover; color: $text-primary } } }
                }
            }
        }
    }
}
