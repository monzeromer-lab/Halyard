// A reference panel: the demo on the left, the note on the right.
component Spec(note: String) {
    Grid(columns: 2) {
        style { gap: 0; border: 1px solid $line-default; border-radius: $radius-md; overflow: hidden; background: $surface-raised; @media (max-width: 768px) { grid-template-columns: 1fr } }
        Row(align: .center) {
            style { padding: 22px 24px; gap: 12px; border-right: 1px solid $line-hairline; @media (max-width: 768px) { border-right: 0; border-bottom: 1px solid $line-hairline } }
            children
        }
        Text(note) { style { margin: 0; padding: 18px 20px; background: $surface-sunken; font-family: $font-mono; font-size: 12px; line-height: 1.7; color: $text-secondary; white-space: pre-wrap } }
    }
}
