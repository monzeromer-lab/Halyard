Component LogoSlot (label: String) {
    Text(label) { style { display: "flex"  align-items: "center"  justify-content: "center"  height: "52px"  margin: "0"  border: "1px dashed var(--line-strong)"  border-radius: "var(--radius-sm)"  font: "600 12px/1 var(--font-mono)"  color: "var(--text-tertiary)" } }
}
