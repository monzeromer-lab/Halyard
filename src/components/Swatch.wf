component Swatch(name: String, hex: String) {
    Stack {
        style { gap: 6px }
        Container { style { height: 52px; border-radius: $radius-sm; border: 1px solid $line-hairline; background: {hex}; padding: 0; margin: 0; width: 100% } }
        Row { style { flex-wrap: nowrap; gap: 8px }
            Text(name) { style { margin: 0; flex-grow: 1; font-family: $font-mono; font-size: 11px; color: $text-secondary } }
            Text(hex) { style { margin: 0; font-family: $font-mono; font-size: 11px; color: $text-tertiary } } }
    }
}
