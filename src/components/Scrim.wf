// The scrim under an overlay: a button that closes it, named for what it
// closes. `dim` is false for a menu or popover, which sit on the page.
Component Scrim (label: String, dim: Bool = true) {
    derived bg = if dim { "rgba(5, 6, 8, 0.62)" } else { "transparent" }
    derived blur = if dim { "blur(2px)" } else { "none" }
    Button("", type: "button", aria-label: label) {
        style { position: "fixed"  inset: "0"  width: "100%"  height: "100%"  border: "0"  padding: "0"  margin: "0"  background: bg  backdrop-filter: blur  z-index: "800"  cursor: "default"  border-radius: "0" }
        UiStore.close()
    }
}
