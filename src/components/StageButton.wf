// One pipeline stage: selected in aria-pressed, the dot filled brand while
// the stage is active, hollow success once done.
Component StageButton (label: String, dur: String, note: String, selected: Bool = false, active: Bool = false) {
    derived bg = if selected { "var(--surface-active)" } else { "transparent" }
    derived edge = if selected { "var(--brand)" } else { "var(--line-hairline)" }
    derived dot = if active { "var(--brand)" } else { "var(--success)" }
    derived dotBg = if active { "var(--brand)" } else { "transparent" }
    Button("", type: "button", aria-pressed: selected, aria-label: "{label}, {dur}, {note}") {
        style {
            display: "flex"  flex-direction: "column"  gap: "7px"  align-items: "flex-start"  flex-grow: "1"  flex-basis: "0"  min-width: "0"
            background: bg  border: "1px solid var(--edge)"  --edge: edge  padding: "12px 14px"  border-radius: "var(--radius-md)"  cursor: "pointer"  text-align: "left"
            transition: "border-color var(--d-fast) var(--ease-standard), background var(--d-fast) var(--ease-standard)"
            hover { background: "var(--surface-hover)"  border-color: "var(--line-strong)" }
            @media (max-width: 768px) { flex-basis: "calc(50% - 6px)" }
        }
        Row(align: center) { style { gap: "8px"  width: "100%"  flex-wrap: "nowrap" }
            Container { style { width: "18px"  height: "18px"  border-radius: "50%"  flex: "none"  background: dotBg  border: "1.5px solid var(--dot)"  --dot: dot  padding: "0"  margin: "0" } }
            Text(label) { style { margin: "0"  flex-grow: "1"  font: "700 13px/1.2 var(--font-sans)"  color: "var(--text-primary)" } }
            Container { style { flex: "none"  padding: "0"  margin: "0"  width: "auto"  white-space: "nowrap" }  Num(text: dur, size: "12px", color: "var(--text-tertiary)", weight: "400") } }
        Text(note) { style { margin: "0"  font-size: "12px"  line-height: "1.4"  color: "var(--text-tertiary)"  padding-left: "26px" } }
    }
}
