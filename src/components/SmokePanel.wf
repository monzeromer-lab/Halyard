Component SmokePanel (title: String) {
    Container {
        style {
            margin-top: "24px"  padding: "24px"  background: "var(--surface-raised)"  border: "1px solid var(--line-default)"  border-radius: "var(--radius-md)"
            @media (max-width: 768px) { padding: "16px" }
        }
        Heading(title, h2) { style { font-size: "20px"  font-weight: "700"  margin-bottom: "8px" } }
        children
    }
}
