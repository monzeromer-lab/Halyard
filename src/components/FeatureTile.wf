// A landing-page feature card: icon well, title, body, and an arrow that
// slides on hover.
Component FeatureTile (icon: String, tone: String, title: String, body: String) {
    Stack(data-interactive: "true") {
        style { gap: "14px"  min-height: "246px"  padding: "24px"  background: "var(--surface-raised)"  border: "1px solid var(--line-default)"  border-radius: "var(--radius-md)"
                transition: "border-color var(--d-base) var(--ease-standard), box-shadow var(--d-base) var(--ease-standard), transform var(--d-base) var(--ease-standard)"
                hover { border-color: "var(--line-strong)"  box-shadow: "var(--shadow-md)"  transform: "translateY(-2px)" } }
        Container { style { width: "40px"  height: "40px"  border-radius: "var(--radius-sm)"  display: "inline-flex"  align-items: "center"  justify-content: "center"  background: "var(--surface-inset)"  color: tone  padding: "0"  margin: "0"  font-size: "18px" }
            Icon(icon) { style { display: "inline-flex" } } }
        Heading(title, h3) { style { margin: "0"  font-size: "20px"  font-weight: "700"  letter-spacing: "-0.01em" } }
        Text(body) { style { margin: "0"  font-size: "14px"  line-height: "1.55"  color: "var(--text-secondary)" } }
        Icon("arrow-right") { style { margin-top: "auto"  color: tone  display: "inline-flex"  opacity: "0.45"  transition: "transform var(--d-base) var(--ease-standard), opacity var(--d-base) linear" } }
    }
}
