// A rail item: icon (or none — a wrong metaphor is worse than no icon),
// label, and a brand bar that appears on the current route.
component RailLink(label: String, to: String, icon: String = "", prefix: Bool = false) {
    derived mode = if prefix { "prefix" } else { "exact" }
    Link(to: to, active: mode) {
        style {
            position: relative; display: flex; align-items: center; gap: 10px; height: 34px; padding: 0 10px; border-radius: $radius-sm
            color: $text-tertiary; font: 600 13px/1 $font-sans; text-decoration: none
            transition: background $d-fast $ease-standard, color $d-fast $ease-standard
            &:hover { background: $surface-hover; color: $text-primary }
            &[aria-current="page"] { background: $surface-active; color: $text-primary; --bar: 1 }
        }
        // The brand bar the current item carries; --bar is set by the current rule.
        Container { style { position: absolute; left: 0; width: 2px; height: 16px; background: $brand; border-radius: 2px; opacity: var(--bar, 0); padding: 0; margin: 0 } }
        if icon != "" {
            Icon(icon) { style { display: inline-flex; flex: none; opacity: 0.9; font-size: 16px } }
        }
        Text(label) { style { margin: 0; font: inherit; color: inherit } }
    }
}
