// A dismissible inline alert: the tone in data-tone and in the title's
// colour, a word in the title, a real dismiss button.
Component InlineAlert (tone: String, title: String, body: String) {
    derived bg = if tone == "success" { "var(--success-soft)" } else if tone == "warning" { "var(--warning-soft)" } else if tone == "danger" { "var(--danger-soft)" } else { "var(--info-soft)" }
    derived edge = if tone == "success" { "var(--success)" } else if tone == "warning" { "var(--warning)" } else if tone == "danger" { "var(--danger)" } else { "var(--info)" }
    derived fg = if tone == "success" { "var(--text-success)" } else if tone == "warning" { "var(--text-warning)" } else if tone == "danger" { "var(--text-danger)" } else { "var(--text-info)" }
    derived icon = if tone == "success" { "check" } else if tone == "info" { "info" } else { "warning" }
    state shown = true
    if shown {
        Row(role: "status", data-tone: tone, align: start) {
            style { gap: "12px"  padding: "14px 16px"  background: bg  border: "1px solid var(--edge)"  --edge: edge  border-radius: "var(--radius-md)"  flex-wrap: "nowrap"  align-items: "flex-start" }
            Icon(icon) { style { color: edge  flex: "none"  display: "inline-flex"  font-size: "16px" } }
            Stack { style { gap: "4px"  flex-grow: "1"  min-width: "0" }
                Text(title) { style { margin: "0"  font: "700 13px/1.3 var(--font-sans)"  color: fg } }
                Text(body) { style { margin: "0"  font-size: "13px"  line-height: "1.55"  color: "var(--text-secondary)" } } }
            IconBtn(icon: "close", label: "Dismiss: {title}", size: 26) { shown = false }
        }
    }
}
