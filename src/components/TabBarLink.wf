component TabBarLink(label: String, to: String, icon: String) {
    Link(to: to, active: "exact") {
        style { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; flex-grow: 1; min-height: 56px; color: $text-tertiary; font: 600 10px/1.2 $font-sans; text-decoration: none
                transition: color $d-fast $ease-standard; &[aria-current="page"] { color: $text-brand } }
        Icon(icon) { style { display: inline-flex; font-size: 22px } }
        Text(label) { style { margin: 0; font: inherit; color: inherit } }
    }
}
