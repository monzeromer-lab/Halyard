// One hop of the request path. The name is a button whose pressed state
// is the selection; the row carries data-selected for the tint, and the
// upstream row is marked as the hop Halyard does not control.
Component HopRow (n: String, label: String, kindWord: String, color: String, what: String, selected: Bool = false, hot: Bool = false, external: Bool = false) {
    derived bg = if selected { "var(--surface-active)" } else { "transparent" }
    derived edge = if selected { "var(--brand)" } else { "transparent" }
    derived sel = if selected { "true" } else { "false" }
    derived hotWord = if hot { "every request" } else { "some requests" }
    derived hotColor = if hot { "var(--text-brand)" } else { "var(--text-tertiary)" }
    Trow(data-selected: sel, data-external: external) {
        style { background: bg  box-shadow: "inset 2px 0 0 var(--edge)"  --edge: edge  transition: "background var(--d-fast) var(--ease-standard)" }
        Tcell("") { style { padding: "0"  border-bottom: "1px solid var(--line-hairline)" }
            Button("", type: "button", aria-pressed: selected, aria-label: "{label}, {kindWord}") {
                style { display: "flex"  align-items: "center"  gap: "12px"  width: "100%"  background: "none"  border: "0"  padding: "12px 14px"  cursor: "pointer"  text-align: "left"  color: "var(--text-primary)"  font: "600 14px/1.3 var(--font-sans)"  hover { background: "var(--surface-hover)" } }
                Num(text: n, size: "11px", color: "var(--text-disabled)", weight: "400")
                Container { style { width: "12px"  height: "12px"  border-radius: "3px"  border: "1.5px solid var(--kind)"  --kind: color  background: "transparent"  flex: "none"  padding: "0"  margin: "0" } }
                Text(label) { style { margin: "0"  font: "inherit"  color: "inherit" } }
                if external { StatusBadge(label: "not ours", tone: "neutral", dot: false) }
            } }
        Tcell("") { style { padding: "12px"  border-bottom: "1px solid var(--line-hairline)"  white-space: "nowrap" }  Overline(text: kindWord, color: color) }
        Tcell(what) { style { padding: "12px"  border-bottom: "1px solid var(--line-hairline)"  font-size: "13px"  color: "var(--text-secondary)"  line-height: "1.5" } }
        Tcell(hotWord) { style { padding: "12px"  border-bottom: "1px solid var(--line-hairline)"  font-size: "12px"  color: hotColor  white-space: "nowrap" } }
    }
}
