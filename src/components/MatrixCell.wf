// A comparison cell: yes is a check in success, no a dash in text-disabled —
// each with a word for assistive technology — anything else the value itself.
component MatrixCell(value: String) {
    if value == "yes" {
        Table.Cell("", data-numeric: "true") {
            style { text-align: right; padding: 12px; border-bottom: 1px solid $line-hairline }
            Icon("check", aria-label: "included", role: "img") { style { color: $success; display: inline-flex; font-size: 16px } }
        }
    } else if value == "no" {
        Table.Cell("—", data-numeric: "true", aria-label: "not included") {
            style { text-align: right; padding: 12px; border-bottom: 1px solid $line-hairline; color: $text-disabled; font-family: $font-mono }
        }
    } else {
        Table.Cell(value, data-numeric: "true") {
            style { text-align: right; padding: 12px; border-bottom: 1px solid $line-hairline; color: $text-secondary; font-family: $font-mono; font-variant-numeric: tabular-nums }
        }
    }
}
