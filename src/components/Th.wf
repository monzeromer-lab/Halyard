component Th(text: String, numeric: Bool = false) {
    derived align = if numeric { "right" } else { "left" }
    derived family = if numeric { "var(--font-mono)" } else { "var(--font-sans)" }
    Table.Cell(text, data-numeric: numeric).header {
        style { text-align: {align}; font: 700 12px/1.2 $font-sans; font-family: {family}; color: $text-tertiary; padding: 10px 12px; border-bottom: 1px solid $line-default; background: $surface-raised; white-space: nowrap }
    }
}
