// An icon-only button always carries an accessible name.
// `popup` marks a menu trigger: aria-haspopup plus aria-expanded following `expanded`.
component IconBtn(icon: String, label: String, variant: String = "ghost", size: Number = 38, popup: Bool = false, expanded: Bool = false) {
    derived edge = if variant == "outline" { "var(--line-default)" } else { "transparent" }
    derived haspopup = if popup { "menu" } else { null }
    derived isOpen = if popup { expanded } else { null }
    IconButton(icon: icon, label: label, type: "button", data-variant: variant, aria-haspopup: haspopup, aria-expanded: isOpen) {
        style {
            --edge: {edge}
            display: inline-flex; align-items: center; justify-content: center
            width: {size}px; height: {size}px; min-width: {size}px; padding: 0
            border-radius: $radius-sm; border: 1px solid var(--edge); background: transparent
            color: $text-secondary; cursor: pointer; font-size: 17px
            transition: background $d-instant $ease-standard, color $d-instant $ease-standard
            &:hover { background: $surface-hover; color: $text-primary }
        }
    }
}
