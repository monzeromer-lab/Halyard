// A card-shaped panel with a header row: title, an optional note, and an
// optional link out. The body is the caller's block.
Component Panel (title: String, note: String = "", link: String = "", to: String = "", bodyPadding: String = "8px") {
    Stack {
        style { gap: "0"  background: "var(--surface-raised)"  border: "1px solid var(--line-default)"  border-radius: "var(--radius-md)"  overflow: "hidden"  min-width: "0" }
        Row(align: center) { style { flex-wrap: "nowrap"  gap: "12px"  padding: "16px 18px"  border-bottom: "1px solid var(--line-hairline)" }
            Heading(title, h2) { style { margin: "0"  font-size: "17px"  font-weight: "700"  flex-grow: "1" } }
            if note != "" { Text(note) { style { margin: "0"  font-size: "12px"  color: "var(--text-tertiary)" } } }
            if link != "" { Link(link, to: to) { style { font: "600 13px/1 var(--font-sans)"  color: "var(--text-brand)"  text-decoration: "none"  white-space: "nowrap"  hover { color: "var(--brand-hover)" } } } } }
        Container { style { padding: bodyPadding  width: "100%"  max-width: "100%"  min-width: "0"  margin: "0" }  children }
    }
}
