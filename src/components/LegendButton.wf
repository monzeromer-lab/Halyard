// A legend entry that hides its series: aria-pressed is the state, and a
// hidden series reads disabled.
Component LegendButton (name: String, shown: Bool = true, swatch: String) {
    derived fg = if shown { "var(--text-secondary)" } else { "var(--text-disabled)" }
    Button(name, type: "button", aria-pressed: shown) {
        style {
            display: "inline-flex"  align-items: "center"  gap: "8px"  background: "none"  border: "0"  padding: "4px 8px"
            border-radius: "var(--radius-sm)"  cursor: "pointer"  font: "600 12px/1 var(--font-sans)"  color: fg
            transition: "background var(--d-fast) var(--ease-standard)"
            hover { background: "var(--surface-hover)"  color: "var(--text-primary)" }
        }
        Container { style { width: "10px"  height: "10px"  border-radius: "3px"  background: swatch  flex: "none"  padding: "0"  margin: "0"  order: "-1" } }
    }
}
