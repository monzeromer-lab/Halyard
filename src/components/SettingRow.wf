// A settings row: the name and its explanation on the left, the control on
// the right. Stacks under 768px.
Component SettingRow (title: String, help: String, last: Bool = false) {
    derived line = if last { "0" } else { "1px solid var(--line-hairline)" }
    Row(align: start) {
        style { gap: "28px"  padding: "20px 0"  border-bottom: line  flex-wrap: "nowrap"  align-items: "flex-start"  @media (max-width: 768px) { flex-wrap: "wrap"  gap: "12px" } }
        Stack { style { width: "260px"  flex: "none"  gap: "4px"  @media (max-width: 768px) { width: "100%" } }
            Text(title) { style { margin: "0"  font: "700 14px/1.3 var(--font-sans)"  color: "var(--text-primary)" } }
            Text(help) { style { margin: "0"  font-size: "13px"  line-height: "1.55"  color: "var(--text-tertiary)" } } }
        Stack { style { flex-grow: "1"  min-width: "0"  max-width: "520px"  gap: "0" }  children }
    }
}
