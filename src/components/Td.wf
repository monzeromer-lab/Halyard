Component Td (text: String, numeric: Bool = false, mono: Bool = false, color: String = "var(--text-secondary)") {
    derived align = if numeric { "right" } else { "left" }
    derived family = if numeric || mono { "var(--font-mono)" } else { "var(--font-sans)" }
    derived fg = if mono && color == "var(--text-secondary)" { "var(--text-brand)" } else { color }
    Tcell(text, data-numeric: numeric) {
        style { text-align: align  font-family: family  font-variant-numeric: "tabular-nums"  padding: "12px"  border-bottom: "1px solid var(--line-hairline)"  color: fg  vertical-align: "middle" }
    }
}
