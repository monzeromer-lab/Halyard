// A launcher on the overlays board: the overlay's name and its key, if any.
component LaunchButton(label: String, hint: String = "") {
    Button("", type: "button", aria-label: label) {
        style {
            display: flex; align-items: center; gap: 10px; width: 100%; background: $surface-raised; border: 1px solid $line-default; padding: 12px 14px
            border-radius: $radius-sm; cursor: pointer; text-align: left; font: 600 14px/1.3 $font-sans; color: $text-primary
            transition: border-color $d-fast $ease-standard, background $d-fast $ease-standard
            &:hover { border-color: $line-strong; background: $surface-hover }
        }
        Text(label) { style { margin: 0; flex-grow: 1; font: inherit; color: inherit } }
        if hint != "" { Kbd(text: hint) }
    }
}
