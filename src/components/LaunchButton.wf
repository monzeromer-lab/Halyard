// A launcher on the overlays board: the overlay's name and its key, if any.
Component LaunchButton (label: String, hint: String = "") {
    Button("", type: "button", aria-label: label) {
        style {
            display: "flex"  align-items: "center"  gap: "10px"  width: "100%"  background: "var(--surface-raised)"  border: "1px solid var(--line-default)"  padding: "12px 14px"
            border-radius: "var(--radius-sm)"  cursor: "pointer"  text-align: "left"  font: "600 14px/1.3 var(--font-sans)"  color: "var(--text-primary)"
            transition: "border-color var(--d-fast) var(--ease-standard), background var(--d-fast) var(--ease-standard)"
            hover { border-color: "var(--line-strong)"  background: "var(--surface-hover)" }
        }
        Text(label) { style { margin: "0"  flex-grow: "1"  font: "inherit"  color: "inherit" } }
        if hint != "" { Kbd(text: hint) }
    }
}
