// A page title assistive technology reads; the breadcrumb shows it to
// everyone else. Every product page has one so the outline is complete.
Component SrTitle (text: String) {
    Heading(text, h1) { style { position: "absolute"  width: "1px"  height: "1px"  padding: "0"  margin: "-1px"  overflow: "hidden"  clip: "rect(0, 0, 0, 0)"  white-space: "nowrap"  border: "0" } }
}
