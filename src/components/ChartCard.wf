// A chart panel: title and a one-line lead in the header, the drawing in the
// body. Charts are built from boxes (no inline SVG); every one has a table or
// a labelled value behind it.
Component ChartCard (title: String, lead: String) {
    Stack {
        style { gap: "0"  background: "var(--surface-raised)"  border: "1px solid var(--line-default)"  border-radius: "var(--radius-md)"  overflow: "hidden"  min-width: "0" }
        Stack { style { gap: "3px"  padding: "16px 18px 10px" }
            Heading(title, h2) { style { margin: "0"  font-size: "17px"  font-weight: "700"  letter-spacing: "-0.01em" } }
            Text(lead) { style { margin: "0"  font-size: "12px"  color: "var(--text-tertiary)" } } }
        Container { style { padding: "0 18px 16px"  width: "100%"  max-width: "100%"  min-width: "0"  margin: "0" }  children }
    }
}
