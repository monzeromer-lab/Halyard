// A visibly marked gap: a real fact the design does not have.
component Placeholder(text: String, size: String = "14px") {
    Text(text) {
        style {
            display: inline-block; margin: 0; padding: 2px 8px; border: 1px dashed $line-strong; border-radius: $radius-xs
            font-family: $font-mono; font-size: {size}; color: $text-tertiary; background: $surface-inset
        }
    }
}
