// Code on surface-sunken. Literal braces in the source are escaped \{ \}.
component CodeBlock(code: String, size: String = "14px", padding: String = "16px 18px") {
    Code(code).block {
        style {
            display: block; margin: 0; padding: {padding}; background: $surface-sunken; border: 1px solid $line-hairline
            border-radius: $radius-sm; font-family: $font-mono; font-size: {size}; line-height: 1.6
            color: $text-secondary; white-space: pre; overflow-x: auto
        }
    }
}
