// Fluant Ink — every token from design/artboards/Patterns.dc.html :root
// (removed after the build; `git checkout efe1d97 -- design`), plus
// the baseline names the structural stylesheet still reads (focus ring, overlay
// fills, fonts, radii). Reference from any style block as "var(--surface-raised)".
theme FluantInk {
    // Surfaces
    surface-canvas: #0b0c0e
    surface-sunken: #060708
    surface-raised: #131519
    surface-overlay: #1a1d23
    surface-inset: #101318
    surface-hover: #1f232a
    surface-active: #262b33
    surface-disabled: #15181d
    surface-scrim: rgba(4,5,7,0.74)

    // Lines
    line-hairline: #1c2026
    line-default: #2a2f37
    line-strong: #3d444f
    border-control: #6b7482
    focus-ring: #ff9a6b

    // Text
    text-primary: #f4f1ec
    text-secondary: #b9bec7
    text-tertiary: #949ba7
    text-disabled: #5d646f
    text-inverse: #0b0c0e
    text-brand: #ff8a5c
    text-accent: #58e8bf
    text-brass: #e6c979

    // Brand, accent, brass
    brand: #ff6a2b
    brand-hover: #ff804a
    brand-soft: #2a1409
    on-brand: #180a03
    accent: #35e0b0
    accent-hover: #5aeac3
    accent-soft: #07221c
    on-accent: #04130f
    brass: #d9b45a
    brass-soft: #241c0c
    on-brass: #1a1405

    // Status
    success: #3ad07f
    success-soft: #06231a
    text-success: #66dd9f
    on-success: #04170f
    warning: #f5b53c
    warning-soft: #241a06
    text-warning: #f7c869
    on-warning: #1c1301
    danger: #ff5d5d
    danger-soft: #2a0d0f
    text-danger: #ff8585
    on-danger: #1e0505
    info: #48b6ef
    info-soft: #06202c
    text-info: #79ccf5
    on-info: #03151e

    // Data series, drawn in order, never reordered
    viz-1: #ff6a2b
    viz-2: #35e0b0
    viz-3: #d9b45a
    viz-4: #48b6ef
    viz-5: #ff8fc0
    viz-6: #a9d84a
    viz-7: #9b8cff
    viz-8: #c98a62

    // Type
    font-display: "Fraunces", "Iowan Old Style", "Palatino Linotype", Georgia, serif
    font-sans: "Manrope", "Segoe UI", system-ui, -apple-system, sans-serif
    font-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace

    // Radius
    radius-xs: 3px
    radius-sm: 6px
    radius-md: 10px
    radius-lg: 16px
    radius-xl: 24px
    radius-2xl: 36px
    radius-pill: 999px

    // Depth — hairlines and glow, not soft shadows
    shadow-sm: 0 2px 8px rgba(0,0,0,.55)
    shadow-md: 0 10px 24px rgba(0,0,0,.55)
    shadow-lg: 0 24px 60px rgba(0,0,0,.65)
    shadow-xl: 0 48px 120px rgba(0,0,0,.7)
    glow-brand: 0 0 0 1px rgba(255,106,43,.5), 0 12px 40px rgba(255,106,43,.28)
    glow-accent: 0 0 0 1px rgba(53,224,176,.45), 0 12px 40px rgba(53,224,176,.24)

    // Motion
    ease-standard: cubic-bezier(0.2,0,0,1)
    ease-entrance: cubic-bezier(0.16,1,0.3,1)
    ease-exit: cubic-bezier(0.7,0,0.84,0)
    ease-spring: cubic-bezier(0.34,1.56,0.64,1)
    ease-anticipate: cubic-bezier(0.68,-0.4,0.27,1.4)
    d-instant: 80ms
    d-fast: 140ms
    d-base: 220ms
    d-slow: 380ms
    d-slower: 620ms
    d-cine: 1100ms

    // Baseline names the structural sheet reads. `color-primary` paints only
    // the :focus-visible ring here (no `primary` modifier is used anywhere),
    // so it carries the design's focus-ring value; A13 reports it against a
    // white button label that never exists — accepted, see NOTES.md.
    color-primary: #ff9a6b
    color-background: #0b0c0e
    color-surface: #1a1d23
    color-text: #f4f1ec
    color-text-muted: #949ba7
    color-border: #2a2f37
    font-family: "Manrope", "Segoe UI", system-ui, -apple-system, sans-serif
    font-family-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace
}
