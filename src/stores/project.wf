// The demo project: its identity, the live release, the 19 regions and the
// overview timeline. All fictional.
Store ProjectStore {
    state name = "storefront-edge"
    state id = "hl-2201"
    state env = "production"
    state domain = "storefront.example.com"
    state release = "sha256:8f2c41…a7"
    state releaseShort = "8f2c41"
    state promoted = "promoted 2 minutes ago by [YOUR NAME]"
    state owner = "[YOUR NAME]"
    state initials = "YN"

    state regions = [
        { code: "fra1", p95: 34 }, { code: "iad1", p95: 41 }, { code: "cdg1", p95: 36 }, { code: "sfo1", p95: 52 }, { code: "gru1", p95: 148 },
        { code: "hnd1", p95: 61 }, { code: "syd1", p95: 74 }, { code: "bom1", p95: 88 }, { code: "jnb1", p95: 96 }, { code: "arn1", p95: 44 },
        { code: "dub1", p95: 39 }, { code: "sin1", p95: 67 }, { code: "yyz1", p95: 45 }, { code: "icn1", p95: 63 }, { code: "cpt1", p95: 104 },
        { code: "lhr1", p95: 34 }, { code: "ams1", p95: 35 }, { code: "nrt1", p95: 59 }, { code: "pdx1", p95: 49 }
    ]
    derived regionHealth = regions.map(r => { code: r.code, p95: r.p95, color: if r.code == "gru1" { "var(--warning)" } else { "var(--success)" }, word: if r.code == "gru1" { "degraded" } else { "operational" } })
    derived healthy = regions.filter(r => r.code != "gru1").length

    state showDetail = true
    state events = [
        { title: "Release rl_4a91 promoted to 100%", time: "14:02", active: false, body: "[YOUR NAME] promoted build 8f2c41 from 10% after 40 minutes at partial traffic." },
        { title: "Canary at 10% for 40 minutes", time: "13:22", active: false, body: "Error rate held at 0.02%, p95 within 6 ms of the previous release." },
        { title: "Build 8f2c41 signed", time: "13:19", active: false, body: "Reproducible attestation matched the previous build of the same tree." },
        { title: "Alert cleared: gru1 latency", time: "11:48", active: false, body: "p95 in gru1 returned under 200 ms after the upstream provider recovered." },
        { title: "Alert opened: gru1 latency", time: "11:06", active: true, body: "p95 crossed 200 ms for 5 consecutive minutes. Paged the on-call rota." }
    ]
    derived detailLabel = if showDetail { "Hide detail" } else { "Show detail" }

    action toggleDetail() { showDetail = !showDetail }
}
