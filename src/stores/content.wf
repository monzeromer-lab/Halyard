// Marketing content: the landing page's panels, code samples and FAQ, the
// plans, the changelog and the docs tree. All of it is the design's seed
// data; nothing here is invented.
Store ContentStore {
    state regions = ["fra1", "iad1", "cdg1", "sfo1", "gru1", "hnd1", "syd1", "bom1", "jnb1", "arn1", "dub1", "sin1", "yyz1", "icn1", "cpt1", "lhr1", "ams1", "nrt1", "pdx1"]

    state features = [
        { tone: "var(--text-brand)", icon: "upload", title: "Atomic global deploys", body: "Every build lands in all 19 regions in the same second. There is no region flag to set and no staged rollout to configure, because there is no staged rollout." },
        { tone: "var(--text-accent)", icon: "check", title: "Signed, reproducible builds", body: "Each build is content-addressed and signed at the end of the pipeline. Rebuild the same commit next year and the hash matches or the deploy is refused." },
        { tone: "var(--text-brass)", icon: "filter", title: "Request-level routing", body: "Route on header, cookie, geo or a value you compute in a 2 ms middleware. Rules are versioned with the deploy, not with a dashboard toggle." },
        { tone: "var(--text-info)", icon: "copy", title: "Edge state that is not a cache", body: "Strongly consistent KV and queues that read in the region the request landed in. Writes replicate in under 90 ms p95 between any two regions." },
        { tone: "var(--text-accent)", icon: "eye", title: "A trace on every request", body: "Not a sample. Every request carries a trace with the build hash, the region, the route rule that matched and the cold-start cost, kept for 30 days." },
        { tone: "var(--text-brand)", icon: "arrow-left", title: "Rollback by hash", body: "Any build that ever ran is one command away. Rollback is a routing change, not a rebuild, so it completes in about 400 ms worldwide." }
    ]

    state panels = {
        build: { cmd: "halyard build", note: "The pipeline is a list of named steps. Each one is cacheable on its own, so a dependency change does not re-run the compile.", cta: "Open a build", to: "/app/builds/8f2c41", rows: [
            { label: "Resolved 412 modules from the lockfile", meta: "0.9 s", dot: "var(--success)" },
            { label: "Compiled 38 routes to the edge target", meta: "14.2 s", dot: "var(--success)" },
            { label: "Signed artifact sha256:8f2c41…a7", meta: "0.4 s", dot: "var(--success)" },
            { label: "Packed 6.8 MB, 2.1 MB gzipped", meta: "1.1 s", dot: "var(--success)" },
            { label: "Uploading to 19 regions", meta: "5.8 s", dot: "var(--brand)" }
        ] },
        route: { cmd: "routes.halyard.ts", note: "Rules are evaluated top to bottom and the first match answers. The fallback is always the last line, and it is always a build hash.", cta: "Edit the rules", to: "/app/editor", rows: [
            { label: "/api/* → edge function api, 3 regions pinned", meta: "match: path", dot: "var(--success)" },
            { label: "cookie ht_beta=1 → build 8f2c41", meta: "match: cookie", dot: "var(--success)" },
            { label: "geo.country in [DE, FR] → fra1 first", meta: "match: geo", dot: "var(--success)" },
            { label: "/assets/* → immutable, 1 year", meta: "match: path", dot: "var(--success)" },
            { label: "* → build 7c91de, all regions", meta: "fallback", dot: "var(--brand)" }
        ] },
        observe: { cmd: "halyard trace --follow", note: "Every line here is one real request with its own trace. Click through to filter by region, status or route rule.", cta: "Open the log stream", to: "/app/logs", rows: [
            { label: "GET /checkout — fra1 — 38 ms — warm", meta: "200", dot: "var(--success)" },
            { label: "POST /api/cart — iad1 — 61 ms — warm", meta: "201", dot: "var(--success)" },
            { label: "GET /p/HL-2201 — sin1 — 112 ms — cold", meta: "200", dot: "var(--warning)" },
            { label: "GET /api/stock — gru1 — 9.4 s — upstream", meta: "504", dot: "var(--danger)" },
            { label: "GET / — cdg1 — 24 ms — warm", meta: "200", dot: "var(--brand)" }
        ] }
    }

    state codes = {
        cfg: "export default defineConfig(\{\n  runtime: 'edge',\n  regions: 'all',  // 19 today, more as they open\n  build: \{ command: 'pnpm build', reproducible: true \},\n  routes: [\n    \{ match: '/api/*', fn: 'api', timeout: 10_000 \},\n    \{ match: \{ cookie: \{ ht_beta: '1' \} \}, build: '8f2c41' \},\n  ],\n\})",
        cli: "$ halyard deploy --wait\n✓ build 8f2c41 signed in 22.4 s\n✓ 19/19 regions acknowledged in 412 ms\n✓ routing switched, 0 requests dropped\n\n$ halyard rollback --to 7c91de\n! 7c91de last ran 4 days ago\n✓ routing switched in 388 ms",
        api: "# promote a build without rebuilding\nPOST https://api.halyard.dev/v1/projects/hl-2201/releases\n  -H 'authorization: bearer $HALYARD_TOKEN'\n  -d '\{\"build\":\"8f2c41\",\"traffic\":100\}'\n\n# response\n\{ \"release\": \"rl_4a91\", \"regions\": 19, \"ms\": 412 \}"
    }

    state faqs = [
        { id: "q1", q: "What happens to in-flight requests during a deploy?", a: "They finish on the build they started on. Halyard switches routing, not processes: the old build keeps serving anything already in its queue and is drained once the last response leaves, usually inside two seconds." },
        { id: "q2", q: "Can I keep a region out?", a: "Yes, but it is a routing rule, not a build flag. The artifact still lands everywhere so a rollback or a geo change does not need a rebuild — the rule decides who is allowed to answer." },
        { id: "q3", q: "Is the edge KV eventually consistent?", a: "No. Reads are served from the region the request landed in and writes are linearised through a per-key leader. Cross-region write visibility is 90 ms p95; if you need it faster, pin the key's leader to the region that writes most." },
        { id: "q4", q: "How do you price a request that fans out?", a: "One request in, one request billed. Internal calls between your own functions, KV reads and queue operations are counted separately and shown per route in the usage view." },
        { id: "q5", q: "What do I have to change to move an existing app?", a: "A config file and, usually, your session store. Node built-ins that touch the filesystem are the common blocker — the CLI reports them before the first deploy rather than at runtime." }
    ]

    // The comparison matrix: 24 rows in five groups. "yes"/"no" render as a
    // check in success or a dash in text-disabled, each with a word for AT.
    state matrix = [
        { group: "Runtime", rows: [
            { name: "Included requests a month", hobby: "100k", team: "2M pooled", enterprise: "Negotiated" },
            { name: "Regions", hobby: "19", team: "19", enterprise: "19 + dedicated" },
            { name: "Edge function timeout", hobby: "10 s", team: "60 s", enterprise: "300 s" },
            { name: "Cold start p95", hobby: "8.1 ms", team: "8.1 ms", enterprise: "8.1 ms" },
            { name: "Custom domains", hobby: "1", team: "Unlimited", enterprise: "Unlimited" } ] },
        { group: "Builds", rows: [
            { name: "Concurrent builds", hobby: "1", team: "8", enterprise: "Unlimited" },
            { name: "Build minutes a month", hobby: "400", team: "6,000", enterprise: "Negotiated" },
            { name: "Reproducible build attestation", hobby: "no", team: "yes", enterprise: "yes" },
            { name: "Preview deploy per pull request", hobby: "no", team: "yes", enterprise: "yes" },
            { name: "Bring your own build image", hobby: "no", team: "no", enterprise: "yes" } ] },
        { group: "State and routing", rows: [
            { name: "Edge KV storage", hobby: "256 MB", team: "50 GB", enterprise: "Negotiated" },
            { name: "Queues", hobby: "no", team: "yes", enterprise: "yes" },
            { name: "Header, cookie and geo rules", hobby: "yes", team: "yes", enterprise: "yes" },
            { name: "Computed routing middleware", hobby: "no", team: "yes", enterprise: "yes" },
            { name: "Leader pinning per key", hobby: "no", team: "no", enterprise: "yes" } ] },
        { group: "Observability", rows: [
            { name: "Trace retention", hobby: "7 days", team: "30 days", enterprise: "1 year" },
            { name: "Trace export to your sink", hobby: "no", team: "yes", enterprise: "yes" },
            { name: "Log drains", hobby: "1", team: "10", enterprise: "Unlimited" },
            { name: "Alert rules", hobby: "3", team: "50", enterprise: "Unlimited" } ] },
        { group: "Team and governance", rows: [
            { name: "Members", hobby: "1", team: "Unlimited", enterprise: "Unlimited" },
            { name: "SSO and SCIM", hobby: "no", team: "no", enterprise: "yes" },
            { name: "Audit log", hobby: "no", team: "30 days", enterprise: "3 years" },
            { name: "Deploy approvals", hobby: "no", team: "yes", enterprise: "yes" },
            { name: "Support", hobby: "Community", team: "Email, 1 business day", enterprise: "Named engineer" } ] }
    ]

    state addons = [
        { icon: "settings", title: "Dedicated region", body: "Your own capacity in any region, with the leader for every key pinned to it.", price: "[YOUR PRICE] / region / month" },
        { icon: "check", title: "Compliance pack", body: "SOC 2 report, DPA, subprocessor notifications and a signed BAA where it applies.", price: "[YOUR PRICE] / year" },
        { icon: "eye", title: "Extended traces", body: "Keep every trace for a year instead of thirty days, queryable from the explorer.", price: "[YOUR PRICE] / 100M spans" }
    ]

    state pricingFaqs = [
        { q: "What counts as a request?", a: "One request that enters Halyard from the internet. Internal calls between your own functions, KV reads and queue operations are counted separately and shown per route." },
        { q: "What happens if I go over?", a: "Nothing is throttled. The overage appears on the next invoice at the published rate and an alert fires the first time you cross 80% of the included volume." },
        { q: "Can I move between plans mid-month?", a: "Yes. Upgrades apply immediately and are prorated; downgrades apply at the next renewal so you keep what you have already paid for." }
    ]

    // Docs: the nav tree, the on-page contents, the rule parameters and the
    // three formats of the same rules.
    state docsTree = [
        { name: "Start", items: ["Install the CLI", "Your first deploy", "Project layout", "Environment variables"] },
        { name: "Runtime", items: ["Edge functions", "Routing rules", "Middleware", "Edge KV", "Queues", "Limits"] },
        { name: "Builds", items: ["Build pipeline", "Reproducible builds", "Caching", "Monorepos"] },
        { name: "Operate", items: ["Traces", "Log drains", "Alerts", "Rollback"] },
        { name: "Reference", items: ["CLI commands", "REST API", "Config schema", "Error codes"] }
    ]
    state docsToc = [
        { id: "match", label: "The match object" }, { id: "order", label: "Evaluation order" }, { id: "targets", label: "Targets" },
        { id: "compute", label: "Computed rules" }, { id: "params", label: "Rule parameters" }, { id: "errors", label: "What goes wrong" }
    ]
    state ruleParams = [
        { key: "match.path", type: "string | string[]", def: "—", note: "Glob against the pathname. A trailing /* matches any depth; /*.js matches one segment." },
        { key: "match.header", type: "Record<string, string>", def: "—", note: "All listed headers must match. Values are compared case-insensitively after trimming." },
        { key: "match.cookie", type: "Record<string, string>", def: "—", note: "Exact cookie value match. Absent cookies never match, including against an empty string." },
        { key: "match.geo", type: "\{ country?, region?, asn? \}", def: "—", note: "Resolved at the edge from the client address. Falls through when the lookup is unavailable." },
        { key: "match.fn", type: "(req) => boolean", def: "—", note: "A pure function evaluated in under 2 ms. Throwing counts as no match and is logged." },
        { key: "build", type: "string", def: "current", note: "A build hash, or current. Pinning a hash freezes this rule until you change it." },
        { key: "fn", type: "string", def: "—", note: "Name of an edge function in this project. Mutually exclusive with build." },
        { key: "timeout", type: "number", def: "10000", note: "Milliseconds before the request is cut and a 504 is returned to the client." },
        { key: "weight", type: "number", def: "100", note: "Share of matching traffic, 0 to 100. Weighted rules must sum to 100 or the deploy is refused." }
    ]
    state ruleErrors = [
        { code: "HL-4019", text: "A rule after the fallback can never match." },
        { code: "HL-4021", text: "Weighted rules in a group do not sum to 100." },
        { code: "HL-4033", text: "match.fn exceeded the 2 ms budget during the deploy check." }
    ]
    state docsCodes = {
        ts: "import \{ defineRoutes \} from 'halyard'\n\nexport default defineRoutes([\n  // pin the beta cohort to a known build\n  \{ match: \{ cookie: \{ ht_beta: '1' \} \}, build: '8f2c41' \},\n\n  // EU traffic prefers fra1, then falls through\n  \{ match: \{ geo: \{ country: ['DE', 'FR', 'NL'] \} \}, region: 'fra1' \},\n\n  \{ match: \{ path: '/api/*' \}, fn: 'api', timeout: 10_000 \},\n  \{ match: \{ path: '/*' \}, build: 'current' \},\n])",
        json: "\{\n  \"version\": 3,\n  \"routes\": [\n    \{ \"match\": \{ \"cookie\": \{ \"ht_beta\": \"1\" \} \}, \"build\": \"8f2c41\" \},\n    \{ \"match\": \{ \"path\": \"/api/*\" \}, \"fn\": \"api\" \}\n  ]\n\}",
        cli: "$ halyard routes list --project hl-2201\n  1  cookie ht_beta=1          → build 8f2c41\n  2  geo.country in DE,FR,NL   → region fra1\n  3  path /api/*               → fn api\n  4  path /*                   → build current\n\n$ halyard routes test GET /api/cart --cookie ht_beta=1\n→ rule 1 matched, served by build 8f2c41 in fra1"
    }

    // Changelog: ten releases, newest first. Tag tones: added → success,
    // changed → info, fixed → warning, security → brand.
    state releases = [
        { id: "v9.4", date: "18 Sep", title: "Routing rules ship with the build", tags: ["added", "changed"], current: true },
        { id: "v9.3", date: "04 Sep", title: "Queues leave preview", tags: ["added"], current: false },
        { id: "v9.2", date: "27 Aug", title: "Cold start cut to 8.1 ms", tags: ["changed"], current: false },
        { id: "v9.1", date: "19 Aug", title: "Trace export to your own sink", tags: ["added"], current: false },
        { id: "v9.0", date: "05 Aug", title: "Reproducible builds by default", tags: ["changed", "security"], current: false },
        { id: "v8.9", date: "22 Jul", title: "Region fra1 capacity doubled", tags: ["changed"], current: false },
        { id: "v8.8", date: "11 Jul", title: "Fix: cookie rules ignored trailing spaces", tags: ["fixed"], current: false },
        { id: "v8.7", date: "01 Jul", title: "Signed artifacts, SLSA level 3", tags: ["security"], current: false },
        { id: "v8.6", date: "18 Jun", title: "Monorepo project detection", tags: ["added"], current: false },
        { id: "v8.5", date: "06 Jun", title: "Fix: 504 on slow upstream kept the isolate warm", tags: ["fixed"], current: false }
    ]
    state releaseFilter = "all"
    derived filteredReleases = releases.filter(r => releaseFilter == "all" || r.tags.indexOf(releaseFilter) > -1)
    derived releaseCounts = {
        all: releases.length,
        added: releases.filter(r => r.tags.indexOf("added") > -1).length,
        changed: releases.filter(r => r.tags.indexOf("changed") > -1).length,
        fixed: releases.filter(r => r.tags.indexOf("fixed") > -1).length,
        security: releases.filter(r => r.tags.indexOf("security") > -1).length
    }
    state migration = [
        { have: "Rules in the dashboard", then: "Exported to routes.halyard.ts on first deploy", action: "Automatic", tone: "success" },
        { have: "Rules edited after a deploy", then: "Refused; edit the file and redeploy", action: "Breaking", tone: "danger" },
        { have: "Weighted splits", then: "Must now sum to exactly 100", action: "Breaking", tone: "danger" },
        { have: "match.fn", then: "New. No action needed", action: "New", tone: "info" },
        { have: "routes.json v2", then: "Still read, translated on import", action: "Automatic", tone: "success" }
    ]

    action setReleaseFilter(f: String) { releaseFilter = f }

    action tagTone(tag: String) {
        if tag == "added" { return "success" }
        if tag == "changed" { return "info" }
        if tag == "fixed" { return "warning" }
        return "brand"
    }

    action tagLabel(tag: String) {
        if tag == "added" { return "Added" }
        if tag == "changed" { return "Changed" }
        if tag == "fixed" { return "Fixed" }
        return "Security"
    }

    state plans = [
        { id: "hobby", name: "Hobby", badge: "", price: "0", per: "forever", monthly: "0", annual: "0", lead: "One person, one project, and the same runtime everyone else gets.", cta: "Choose Hobby", variant: "secondary", featured: false,
          items: ["100k requests a month", "1 concurrent build", "7-day traces", "1 custom domain", "Community support"] },
        { id: "team", name: "Team", badge: "Most teams", price: "[YOUR PRICE]", per: "per seat, per month", monthly: "[YOUR PRICE]", annual: "[YOUR PRICE − 20%]", lead: "Pooled request volume across every project your team owns.", cta: "Start a 14-day trial", variant: "primary", featured: true,
          items: ["2M pooled requests a month", "8 concurrent builds", "30-day traces", "Preview deploy per pull request", "Routing rules, edge KV and queues", "Deploy approvals and audit log"] },
        { id: "enterprise", name: "Enterprise", badge: "", price: "Talk to us", per: "billed annually", monthly: "Talk to us", annual: "Talk to us", lead: "Dedicated capacity, your compliance paperwork, a named engineer.", cta: "Choose Enterprise", variant: "secondary", featured: false,
          items: ["Negotiated request volume", "Unlimited builds", "1-year traces and export", "Dedicated regions or your own cloud", "SSO, SCIM and a 3-year audit log", "Named support engineer"] }
    ]
}
