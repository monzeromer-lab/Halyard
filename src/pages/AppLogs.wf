page AppLogs(path: "/app/logs", title: "Logs", description: "Request logs across every region, with traces.", noindex: true, layout: AppShell(crumb: "Logs")) {
    use LogStore
    state q = ""

    SrTitle(text: "Logs")
    // Toolbar: search, regex, severity facets, follow, drain
    Row(align: .center) {
        style { padding: 14px 24px; flex-wrap: nowrap; gap: 12px; border-bottom: 1px solid $line-hairline; @media (max-width: 1024px) { flex-wrap: wrap }  @media (max-width: 768px) { padding: 12px 16px } }
        Container { style { position: relative; width: 320px; flex: none; padding: 0; @media (max-width: 768px) { width: 100% } }
            Icon("search") { style { position: absolute; left: 11px; top: 11px; color: $text-tertiary; pointer-events: none; display: inline-flex; font-size: 16px; z-index: 1 } }
            Input(bind: q, id: "log-q", placeholder: LogStore.placeholder, aria-label: "Filter log lines", aria-invalid: LogStore.badRegex).search {
                style { height: 38px; width: 100%; background: $surface-inset; border: 1px solid $border-control; border-radius: $radius-sm; color: $text-primary; padding: 0 12px 0 34px; font: 400 13px/1.2 $font-mono
                        &:hover { border-color: #8a929e }  &::placeholder { color: $text-tertiary }  &:focus-visible { border-color: $focus-ring }  &[aria-invalid="true"] { border-color: $danger } }
                on input { LogStore.setQuery(q) }
            } }
        Chip(label: ".*", pressed: LogStore.regex) { on click { LogStore.toggleRegex() } }
        Container { style { width: 1px; height: 22px; background: $line-default; padding: 0; margin: 0; flex: none; @media (max-width: 768px) { display: none } } }
        Row { style { gap: 8px; flex-grow: 1 }
            for f in LogStore.facets by f.id {
                Chip(label: f.label, pressed: f.pressed, count: f.count) { on click { LogStore.toggleLevel(f.id) } }
            } }
        FlSwitch(checked: LogStore.follow, label: "Follow", id: "follow-label") { on click { LogStore.toggleFollow() } }
        FlButton(label: "Drain", variant: "secondary", size: "sm", icon: "download")
    }

    Row(align: .stretch) {
        style { flex-grow: 1; min-height: 0; flex-wrap: nowrap; gap: 0; align-items: stretch; @media (max-width: 1024px) { flex-wrap: wrap } }
        // The lines
        Stack { style { flex-grow: 1; min-width: 0; gap: 0; flex-basis: 0; @media (max-width: 1024px) { flex-basis: 100% } }
            Row(align: .center) { style { gap: 12px; padding: 10px 24px; border-bottom: 1px solid $line-hairline; flex-wrap: nowrap; @media (max-width: 768px) { padding: 10px 16px; flex-wrap: wrap } }
                StatusBadge(label: LogStore.liveLabel, tone: LogStore.liveTone, live: LogStore.follow)
                Text("{LogStore.shown} of 4,182 lines in the last 5 minutes") { style { margin: 0; font-size: 12px; color: $text-tertiary; flex-grow: 1 } }
                Kbd(text: "↑↓")
                Text("to move") { style { margin: 0; font-size: 12px; color: $text-tertiary } } }
            Stack(role: "group", aria-label: "Log lines") {
                style { gap: 0; padding: 6px 0; background: $surface-sunken; flex-grow: 1; min-height: 320px }
                on keydown(event) {
                    if event.key == "ArrowDown" { event.preventDefault()  LogStore.move(1) }
                    if event.key == "ArrowUp" { event.preventDefault()  LogStore.move(-1) }
                }
                for r in LogStore.rows by r.time {
                    LogLine(time: r.time, level: r.level, color: r.color, region: r.region, route: r.route, status: r.status, statusColor: r.statusColor, ms: r.ms, msColor: r.msColor, message: r.message, selected: r.selected) { on click { LogStore.pick(r.time) } }
                }
                if LogStore.empty {
                    Container { style { padding: 48px 24px; width: 100%; max-width: 100% }
                        EmptyState(title: "Nothing matches that filter", body: "No line in the last five minutes matches. Widen the severity filter or clear the search.") {
                            FlButton(label: "Clear filter", variant: "secondary", size: "sm") { on click { LogStore.reset()  q = "" } }
                        } }
                }
                if LogStore.badRegex {
                    Container { style { padding: 16px 24px; width: 100%; max-width: 100% }
                        Callout(tone: "danger", title: "That pattern will not compile", body: "Fix the expression, or turn the .* switch off to search for it literally.") }
                }
            }
        }
        // The trace detail
        if LogStore.hasSelection {
            Stack(aria-label: "Trace detail").slideLeft.fast {
                style { width: 440px; flex: none; gap: 0; border-left: 1px solid $line-hairline; background: $surface-raised; @media (max-width: 1024px) { width: 100%; border-left: 0; border-top: 1px solid $line-hairline } }
                Row(align: .start) { style { padding: 18px 20px 14px; border-bottom: 1px solid $line-hairline; gap: 12px; flex-wrap: nowrap }
                    Stack { style { flex-grow: 1; min-width: 0; gap: 6px }
                        Overline(text: "TRACE {LogStore.trace}")
                        Heading("{LogStore.current.route}").h2 { style { margin: 0; font: 500 16px/1.3 $font-mono; color: $text-primary } }
                        Row(align: .center) { style { gap: 8px; flex-wrap: nowrap; font-size: 12px; color: $text-tertiary }
                            StatusBadge(label: LogStore.current.status, tone: LogStore.current.tone, dot: false)
                            Num(text: LogStore.current.ms, size: "12px", color: "var(--text-tertiary)", weight: "400")
                            Text("·") { style { margin: 0 } }
                            Text("{LogStore.current.region}") { style { margin: 0; font-family: $font-mono; font-size: 12px } } } }
                    IconBtn(icon: "close", label: "Close trace detail", size: 30) { on click { LogStore.close() } }
                }
                Stack { style { gap: 22px; padding: 18px 20px; flex-grow: 1 }
                    DetailSection(title: "SPANS") {
                        Stack { style { gap: 7px }
                            for s in LogStore.spans by s.name { SpanRow(name: s.name, left: s.left, width: s.width, color: s.color, ms: s.ms) } } }
                    DetailSection(title: "MESSAGE") {
                        Text("{LogStore.current.message}") { style { margin: 0; padding: 12px 14px; font: 400 12.5px/1.6 $font-mono; background: $surface-sunken; border: 1px solid $line-hairline; border-radius: $radius-sm; color: $text-secondary; white-space: pre-wrap } } }
                    DetailSection(title: "REQUEST HEADERS") {
                        Stack { style { gap: 6px }
                            for h in LogStore.headers {
                                Row { style { gap: 12px; flex-wrap: nowrap; font: 400 12px/1.5 $font-mono }
                                    Text(h.k) { style { margin: 0; width: 140px; flex: none; color: $text-tertiary; font: inherit } }
                                    Text(h.v) { style { margin: 0; flex-grow: 1; min-width: 0; color: $text-secondary; word-break: break-all; font: inherit } } }
                            } } }
                    DetailSection(title: "ROUTING") {
                        Stack { style { gap: 8px; padding: 12px 14px; background: $surface-inset; border: 1px solid $line-hairline; border-radius: $radius-sm }
                            Row(align: .center) { style { gap: 10px; flex-wrap: nowrap; font-size: 12px }
                                StatusBadge(label: "rule 3", tone: "brand", dot: false)
                                Text("match: path /*") { style { margin: 0; font: 400 12px/1.5 $font-mono; color: $text-secondary } } }
                            Row(align: .center) { style { gap: 6px; flex-wrap: wrap; font-size: 12px; color: $text-tertiary }
                                Text("served by build") { style { margin: 0; font-size: 12px } }
                                Link("{LogStore.current.build}", to: "/app/builds/{LogStore.current.build}") { style { font: 400 12px/1.5 $font-mono; color: $text-brand; text-decoration: none; &:hover { color: $brand-hover } } }
                                Text("· cold start not incurred") { style { margin: 0; font-size: 12px } } } } }
                }
                Row { style { padding: 14px 20px; border-top: 1px solid $line-hairline; gap: 10px; flex-wrap: nowrap }
                    Container { style { flex-grow: 1; padding: 0; width: auto; display: flex }  FlButton(label: "Open the build", variant: "secondary", size: "sm", to: "/app/builds/{LogStore.current.build}", width: "100%") }
                    Container { style { flex-grow: 1; padding: 0; width: auto; display: flex }  FlButton(label: "Query similar traces", variant: "primary", size: "sm", to: "/app/explorer", width: "100%") }
                }
            }
        }
    }
}
