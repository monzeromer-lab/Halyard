page Onboarding(path: "/new", title: "New project", description: "Connect a repository and ship the first build.", noindex: true) {
    use OnboardStore
    state q = ""

    Row(align: .stretch) {
        style { min-height: 100vh; flex-wrap: nowrap; gap: 0; align-items: stretch; @media (max-width: 1024px) { flex-wrap: wrap } }
        // Steps rail
        Stack { style { width: 320px; flex: none; gap: 0; background: $surface-sunken; border-right: 1px solid $line-hairline; padding: 36px 32px; @media (max-width: 1024px) { width: 100%; border-right: 0; border-bottom: 1px solid $line-hairline; padding: 20px 16px } }
            Link("", to: "/", aria-label: "Halyard home") { style { display: flex; align-items: center; gap: 10px; margin: 0 0 40px; color: $text-primary; text-decoration: none; @media (max-width: 1024px) { margin: 0 0 20px } }
                Mark(size: 24)
                Text("Halyard") { style { margin: 0; font: 700 20px/1 $font-sans; letter-spacing: -0.02em } } }
            Container { style { margin: 0 0 20px; padding: 0; width: auto }  Overline(text: "NEW PROJECT") }
            Stack(role: "list", aria-label: "Steps") { style { gap: 0; @media (max-width: 1024px) { flex-direction: row; flex-wrap: wrap; gap: 0 24px } }
                for s in OnboardStore.steps by s.id { StepItem(label: s.label, note: s.note, phase: s.phase, badge: s.badge, line: s.line, last: s.last) } }
            Stack { style { margin: auto 0 0; gap: 6px; padding: 16px; background: $surface-inset; border: 1px solid $line-hairline; border-radius: $radius-md; @media (max-width: 1024px) { display: none } }
                Text("Nothing is deployed yet") { style { margin: 0; font: 700 13px/1.3 $font-sans } }
                Text("You can leave at any point. The project is created on the last step, not before.") { style { margin: 0; font-size: 12px; line-height: 1.55; color: $text-tertiary } } }
        }

        Stack { style { flex-grow: 1; min-width: 0; gap: 0; flex-basis: 0; @media (max-width: 1024px) { flex-basis: 100% } }
            Stack { style { flex-grow: 1; gap: 0; padding: 48px 48px 32px; overflow-x: hidden; @media (max-width: 768px) { padding: 24px 16px } }
                Heading("{OnboardStore.stepTitle}").h1 { style { margin: 0 0 8px; font-size: 34px; line-height: 1.15; letter-spacing: -0.02em; font-weight: 700; @media (max-width: 768px) { font-size: 28px } } }
                Text("{OnboardStore.stepLead}") { style { margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: $text-secondary; max-width: 62ch } }
                // 1. Repository
                if OnboardStore.atRepo {
                    Stack.slideLeft.fast { style { gap: 0 }
                        Container { style { position: relative; max-width: 520px; margin: 0 0 18px; padding: 0; width: 100% }
                            Icon("search") { style { position: absolute; left: 11px; top: 11px; color: $text-tertiary; pointer-events: none; display: inline-flex; font-size: 16px; z-index: 1 } }
                            Input(bind: q, id: "ob-q", placeholder: "Filter 42 repositories", aria-label: "Filter repositories").search {
                                style { height: 38px; width: 100%; background: $surface-inset; border: 1px solid $border-control; border-radius: $radius-sm; color: $text-primary; padding: 0 12px 0 34px; font: 400 14px/1.2 $font-sans; &:hover { border-color: #8a929e }  &::placeholder { color: $text-tertiary }  &:focus-visible { border-color: $focus-ring } }
                                on input { OnboardStore.setQuery(q) } } }
                        Stack(role: "radiogroup", aria-label: "Repository") { style { gap: 8px; max-width: 620px }
                            for r in OnboardStore.repos by r.id { RepoOption(full: r.full, meta: r.meta, lang: r.lang, checked: r.checked) { on click { OnboardStore.pickRepo(r.id) } } }
                            if OnboardStore.noRepos { Text("No repository matches that filter.") { style { margin: 12px 0; font-size: 14px; color: $text-tertiary } } } }
                    }
                }
                // 2. Framework
                if OnboardStore.atFramework {
                    Stack.slideLeft.fast { style { gap: 0 }
                        Container { style { max-width: 620px; margin: 0 0 24px; padding: 0; width: 100% }
                            Callout(tone: "success", title: "Next.js 15 detected from package.json", body: "38 routes, 6 of them dynamic.") }
                        Grid(columns: 2) { style { gap: 18px; max-width: 620px; @media (max-width: 480px) { grid-template-columns: 1fr } }
                            Select(id: "ob-fw", label: "Framework preset") { Select.Option("Next.js 15", value: "next")  Select.Option("Astro", value: "astro")  Select.Option("SvelteKit", value: "sveltekit")  Select.Option("Remix", value: "remix") }
                            Select(id: "ob-node", label: "Node version") { Select.Option("22.x", value: "22")  Select.Option("20.x", value: "20")  Select.Option("18.x", value: "18") }
                            Input(value: "pnpm build", id: "ob-cmd", label: "Build command", class: "hl-mono").text
                            Input(value: ".halyard/edge", id: "ob-out", label: "Output directory", class: "hl-mono").text }
                        Stack { style { margin: 26px 0 0; max-width: 620px; gap: 12px }
                            Overline(text: "2 THINGS TO LOOK AT")
                            Callout(tone: "danger", title: "src/lib/session.ts imports node:fs", body: "The edge runtime has no filesystem. Move the session store to edge KV, or keep this route on a node function.")
                            Callout(tone: "warning", title: "3 environment variables are unset in preview", body: "Preview deploys will read the production values unless you set preview-specific ones now.") }
                    }
                }
                // 3. Environment
                if OnboardStore.atEnv {
                    Stack.slideLeft.fast { style { gap: 0 }
                        Row(align: .center) { style { gap: 12px; margin: 0 0 14px; max-width: 680px; flex-wrap: nowrap }
                            Text("{OnboardStore.envCount} of 5 selected", role: "status") { style { margin: 0; font-size: 13px; color: $text-tertiary; flex-grow: 1 } }
                            FlButton(label: OnboardStore.envAllLabel, variant: "ghost", size: "sm") { on click { OnboardStore.selectAllEnv() } } }
                        Stack(role: "group", aria-label: "Environment variables to import") { style { gap: 0; border: 1px solid $line-default; border-radius: $radius-md; overflow: hidden; max-width: 680px }
                            for e in OnboardStore.envs by e.key {
                                Row(align: .center) { style { gap: 14px; padding: 13px 16px; border-bottom: 1px solid $line-hairline; flex-wrap: nowrap; @media (max-width: 480px) { flex-wrap: wrap } }
                                    CheckBtn(checked: "{e.checked}", label: e.label) { on click { OnboardStore.toggleEnv(e.key) } }
                                    Text(e.key) { style { margin: 0; width: 210px; flex: none; font: 400 13px/1.4 $font-mono; color: $text-primary; @media (max-width: 480px) { width: auto } } }
                                    Text(e.value) { style { margin: 0; flex-grow: 1; min-width: 0; font: 400 12.5px/1.4 $font-mono; color: $text-tertiary; overflow: hidden; text-overflow: ellipsis; white-space: nowrap } }
                                    StatusBadge(label: e.kind, tone: e.tone, dot: false) }
                            } }
                    }
                }
                // 4. Review
                if OnboardStore.atReview {
                    Stack.slideLeft.fast { style { gap: 0 }
                        Stack(role: "list", aria-label: "Summary") { style { gap: 0; max-width: 680px; border: 1px solid $line-default; border-radius: $radius-lg; overflow: hidden }
                            for s in OnboardStore.summary by s.label {
                                Row(role: "listitem", align: .center) { style { gap: 16px; padding: 15px 20px; border-bottom: 1px solid $line-hairline; flex-wrap: nowrap; @media (max-width: 480px) { flex-wrap: wrap } }
                                    Text(s.label) { style { margin: 0; width: 160px; flex: none; font: 600 13px/1.3 $font-sans; color: $text-tertiary } }
                                    if s.mono {
                                        Text(s.value) { style { margin: 0; flex-grow: 1; min-width: 0; font: 400 14px/1.4 $font-mono; color: $text-primary } }
                                    } else {
                                        Text(s.value) { style { margin: 0; flex-grow: 1; min-width: 0; font-size: 14px; color: $text-primary } }
                                    }
                                    FlButton(label: "Edit", variant: "ghost", size: "sm") { on click { OnboardStore.goTo(s.step) } } }
                            } }
                        Container { style { margin: 22px 0 0; max-width: 680px; padding: 0; width: 100% }
                            Callout(tone: "warning", title: "The node:fs import in src/lib/session.ts is still unresolved", body: "The build will complete, but any request that reaches that route returns a 500 until you move the session store.") }
                    }
                }
            }
            // Footer: progress, back, next
            Row(align: .center) { style { padding: 20px 48px; border-top: 1px solid $line-hairline; gap: 14px; flex-wrap: nowrap; @media (max-width: 768px) { padding: 16px; flex-wrap: wrap } }
                Stack { style { flex-grow: 1; gap: 7px; min-width: 160px }
                    ProgressBar(pct: OnboardStore.progress, label: "Onboarding progress", maxWidth: "220px")
                    Text("{OnboardStore.progressLabel}") { style { margin: 0; font-size: 12px; color: $text-tertiary } } }
                FlButton(label: "Back", variant: "ghost", icon: "arrow-left", disabled: OnboardStore.atFirst) { on click { OnboardStore.back() } }
                if !OnboardStore.isLast { FlButton(label: OnboardStore.nextLabel, variant: "primary", disabled: OnboardStore.blocked) { on click { OnboardStore.next() } } }
                if OnboardStore.isLast { FlButton(label: "Create project and build", variant: "primary", to: "/app/builds/8f2c41") }
            }
        }
    }
}
