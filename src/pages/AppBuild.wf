Page AppBuild (path: "/app/builds/:hash", title: "Build", description: "One build: its pipeline, diff, artifacts and attestation.", noindex) {
    use BuildStore
    BuildStore.open(params.hash)

    AppShell(crumb: "Build {params.hash}") {
        SrTitle(text: "Build {params.hash}")
        if BuildStore.known {
            // Header: hash, badges, actions
            Stack { style { gap: "14px"  padding: "20px 28px 16px"  border-bottom: "1px solid var(--line-hairline)"  @media (max-width: 768px) { padding: "16px" } }
                Row(align: center) { style { gap: "14px"  flex-wrap: "wrap" }
                    Text("{BuildStore.build.hash}") { style { margin: "0"  font: "500 28px/1.1 var(--font-mono)"  letter-spacing: "-0.01em"  color: "var(--text-primary)" } }
                    StatusBadge(label: BuildStore.build.status, tone: BuildStore.build.tone)
                    StatusBadge(label: BuildStore.build.env, tone: "brand", dot: false)
                    OutlineBadge(label: BuildStore.build.traffic)
                    Container { style { flex-grow: "1"  padding: "0"  width: "auto"  @media (max-width: 768px) { display: "none" } } }
                    FlButton(label: "Copy hash", variant: "ghost", size: "sm", icon: "copy") { navigator.clipboard.writeText(BuildStore.build.hash) }
                    FlButton(label: "Redeploy", variant: "secondary", size: "sm", icon: "settings")
                    FlButton(label: "Roll back", variant: "danger", size: "sm", icon: "arrow-left") { navigate("/ui") }
                }
                Row { style { gap: "32px"  flex-wrap: "wrap"  @media (max-width: 768px) { gap: "16px 24px" } }
                    MetaItem(label: "COMMIT", value: BuildStore.build.commit, mono: true)
                    MetaItem(label: "BRANCH", value: BuildStore.build.branch)
                    MetaItem(label: "AUTHOR", value: BuildStore.build.author)
                    MetaItem(label: "TRIGGER", value: BuildStore.build.trigger)
                    MetaItem(label: "DURATION", value: BuildStore.build.duration, mono: true)
                    MetaItem(label: "REGIONS", value: BuildStore.build.regions, mono: true)
                }
            }

            // Pipeline strip
            Row(align: stretch, role: "group", aria-label: "Pipeline stages") {
                style { padding: "18px 28px"  border-bottom: "1px solid var(--line-hairline)"  gap: "0"  flex-wrap: "nowrap"  align-items: "stretch"  @media (max-width: 1024px) { flex-wrap: "wrap"  gap: "8px 12px" }  @media (max-width: 768px) { padding: "16px" } }
                for s in BuildStore.stages {
                    StageButton(label: s.label, dur: s.dur, note: s.note, selected: s.selected, active: s.active) { BuildStore.pickStage(s.id) }
                    if !s.last {
                        Container { style { width: "22px"  flex: "none"  display: "flex"  align-items: "center"  justify-content: "center"  color: "var(--line-strong)"  padding: "0"  margin: "0"  @media (max-width: 1024px) { display: "none" } }
                            Icon("chevron-right") { style { display: "inline-flex"  font-size: "14px" } } }
                    }
                }
            }

            // Tabs
            Row(align: end, role: "tablist", aria-label: "Build detail") {
                style { padding: "0 28px"  border-bottom: "1px solid var(--line-hairline)"  gap: "26px"  flex-wrap: "wrap"  align-items: "flex-end"  @media (max-width: 768px) { padding: "0 16px"  gap: "18px" } }
                for t in BuildStore.tabs {
                    Container { style { padding: "14px 0 0"  width: "auto"  margin: "0"  flex: "none"  display: "flex"  align-items: "baseline"  gap: "7px" }
                        TabButton(label: t.label, selected: t.selected) { BuildStore.pickTab(t.id) }
                        if t.count != "" { Num(text: t.count, size: "13px", color: "var(--text-disabled)", weight: "500") } }
                }
            }

            // Output
            if BuildStore.isOutput {
                Stack { style { gap: "0"  background: "var(--surface-sunken)"  flex-grow: "1"  min-height: "320px" }
                    Row(align: center) { style { padding: "12px 24px"  border-bottom: "1px solid var(--line-hairline)"  gap: "12px"  flex-wrap: "nowrap"  @media (max-width: 768px) { padding: "10px 16px" } }
                        Text("stage: {BuildStore.stageName}") { style { margin: "0"  font: "400 12px/1.2 var(--font-mono)"  color: "var(--text-tertiary)"  flex-grow: "1" } }
                        FlButton(label: "Raw log", variant: "ghost", size: "sm", icon: "link") }
                    Stack(role: "log", aria-label: "Build output") { style { gap: "0"  padding: "18px 24px"  font: "400 13px/1.85 var(--font-mono)"  overflow-x: "auto"  @media (max-width: 768px) { padding: "14px 16px" } }
                        for l in BuildStore.output {
                            Text(l.text) { style { margin: "0"  color: l.color  white-space: "pre-wrap"  font: "inherit" } }
                        } }
                }
            }

            // Diff
            if BuildStore.isDiff {
                Row(align: stretch) { style { gap: "0"  flex-wrap: "nowrap"  align-items: "stretch"  flex-grow: "1"  @media (max-width: 768px) { flex-wrap: "wrap" } }
                    Stack { style { width: "280px"  flex: "none"  gap: "2px"  border-right: "1px solid var(--line-hairline)"  padding: "14px 10px"  @media (max-width: 768px) { width: "100%"  border-right: "0"  border-bottom: "1px solid var(--line-hairline)" } }
                        Container { style { padding: "0 12px 10px"  width: "auto"  margin: "0" }  Overline(text: "4 FILES CHANGED") }
                        for f in BuildStore.files { FileButton(name: f.name, add: f.add, del: f.del, current: f.current) { BuildStore.pickFile(f.name) } } }
                    Stack { style { flex-grow: "1"  min-width: "0"  gap: "0"  background: "var(--surface-sunken)"  padding: "16px 0"  overflow-x: "auto" }
                        Text("@@ -12,7 +12,8 @@ {BuildStore.diffFile}") { style { margin: "0 0 10px"  padding: "0 24px"  font: "400 12px/1.5 var(--font-mono)"  color: "var(--text-tertiary)" } }
                        for l in BuildStore.diffLines {
                            Row(data-kind: l.kind) { style { gap: "0"  flex-wrap: "nowrap"  font: "400 12.5px/1.65 var(--font-mono)"  background: l.bg }
                                Text(l.n, aria-hidden: "true") { style { margin: "0"  width: "46px"  flex: "none"  text-align: "right"  padding-right: "12px"  color: "var(--text-disabled)"  user-select: "none"  font: "inherit" } }
                                Text(l.sign) { style { margin: "0"  width: "18px"  flex: "none"  color: "var(--text-disabled)"  font: "inherit" } }
                                Text(l.text) { style { margin: "0"  flex-grow: "1"  padding-right: "24px"  white-space: "pre-wrap"  color: l.fg  font: "inherit" } } }
                        } }
                }
            }

            // Artifacts
            if BuildStore.isArtifacts {
                Container { style { padding: "20px 28px"  width: "100%"  max-width: "100%"  @media (max-width: 768px) { padding: "16px" } }
                    Container { style { border: "1px solid var(--line-default)"  border-radius: "var(--radius-md)"  overflow: "auto"  background: "var(--surface-raised)"  padding: "0"  width: "100%"  max-width: "100%" }
                        Table(caption: "Files produced by build {BuildStore.build.hash}") {
                            style { width: "100%"  border-collapse: "collapse"  font: "400 14px/1.55 var(--font-sans)"  min-width: "640px" }
                            Thead { Trow { Th(text: "Path")  Th(text: "Content type")  Th(text: "Size", numeric: true)  Th(text: "Digest", numeric: true)  Th(text: "Download") } }
                            Tbody {
                                for a in BuildStore.artifacts {
                                    Trow {
                                        Td(text: a.path, mono: true, color: "var(--text-primary)")
                                        Td(text: a.type, mono: true, color: "var(--text-secondary)")
                                        Td(text: a.size, numeric: true)
                                        Td(text: a.digest, numeric: true, color: "var(--text-accent)")
                                        Tcell("") { style { padding: "6px 12px"  border-bottom: "1px solid var(--line-hairline)"  text-align: "right"  width: "56px" }
                                            IconBtn(icon: "download", label: "Download {a.path}", size: 30) } }
                                } } } } }
            }

            // Attestation
            if BuildStore.isAttestation {
                Row(align: start) { style { padding: "24px 28px"  gap: "20px"  flex-wrap: "nowrap"  align-items: "flex-start"  @media (max-width: 1024px) { flex-wrap: "wrap" }  @media (max-width: 768px) { padding: "16px" } }
                    Stack { style { width: "380px"  flex: "none"  gap: "14px"  padding: "22px"  background: "var(--surface-raised)"  border: "1px solid var(--line-default)"  border-radius: "var(--radius-md)"  @media (max-width: 1024px) { width: "100%" } }
                        Icon("check") { style { color: "var(--text-success)"  display: "inline-flex"  font-size: "28px" } }
                        Heading("Reproducible", h2) { style { margin: "0"  font-size: "20px"  font-weight: "700" } }
                        Text("This tree was built twice on different machines and produced the same digest. The attestation below is what Halyard checks before it will route traffic to the artifact.") { style { margin: "0"  font-size: "14px"  line-height: "1.6"  color: "var(--text-secondary)" } }
                        Row { style { gap: "8px" }  StatusBadge(label: "SLSA level 3", tone: "success", dot: false)  StatusBadge(label: "in-toto v1", tone: "brass", dot: false) } }
                    Container { style { flex-grow: "1"  min-width: "0"  padding: "0"  width: "auto"  max-width: "100%" }
                        CodeBlock(code: "\{\n  \"_type\": \"https://in-toto.io/Statement/v1\",\n  \"subject\": [\{ \"name\": \"edge/bundle.js\",\n    \"digest\": \{ \"sha256\": \"8f2c41d0e7b93a5c1f4880aa27c6be5390e1f2ca\" \} \}],\n  \"predicate\": \{\n    \"buildType\": \"halyard/edge-v9\",\n    \"invocation\": \{ \"commit\": \"a91f3c2\" \},\n    \"reproducible\": true\n  \}\n\}", size: "12.5px", padding: "20px 22px") }
                }
            }
        } else {
            Container { style { padding: "48px 28px"  width: "100%"  max-width: "100%" }
                EmptyState(title: "No build {params.hash}", body: "That hash is not a build of storefront-edge. It may belong to another project, or it was pruned.") {
                    FlButton(label: "See all deployments", variant: "secondary", size: "sm", to: "/app/deployments")
                } }
        }
    }
}
