page Docs(path: "/docs", title: "Routing rules", description: "A routing rule decides which build or function answers a request. Rules live in your repository.") {
    use ContentStore
    use UiStore
    state openStart = false
    state openRuntime = true
    state openBuilds = false
    state openOperate = false
    state openReference = false
    state code = "ts"
    state toc = "match"
    state version = "v3"

    derived codeText = ContentStore.docsCodes[code]

    SiteNav

    // Breadcrumb bar
    Row(align: .center) {
        style { position: sticky; top: 68px; z-index: 90; height: 52px; flex-wrap: nowrap; gap: 16px; padding: 0 80px; background: rgba(11,12,14,0.9); backdrop-filter: blur(6px); border-bottom: 1px solid $line-hairline
                @media (max-width: 1024px) { padding: 0 32px }  @media (max-width: 768px) { padding: 0 16px; top: 60px } }
        Row(align: .center, role: "navigation", aria-label: "Breadcrumb") {
            style { flex-wrap: nowrap; gap: 8px; font-size: 13px; color: $text-tertiary; flex-grow: 1 }
            Link("Docs", to: "/docs") { style { color: $text-tertiary; text-decoration: none } }
            Icon("chevron-right") { style { color: $line-strong; display: inline-flex; font-size: 13px } }
            Text("Runtime") { style { margin: 0; color: $text-tertiary; font-size: 13px } }
            Icon("chevron-right") { style { color: $line-strong; display: inline-flex; font-size: 13px } }
            Text("Routing rules", aria-current: "page") { style { margin: 0; color: $text-primary; font-size: 13px } }
        }
        SegGroup(label: "API version") {
            SegButton(label: "v3", pressed: version == "v3") { on click { version = "v3" } }
            SegButton(label: "v2", pressed: version == "v2") { on click { version = "v2" } }
            SegButton(label: "Beta", pressed: version == "beta") { on click { version = "beta" } }
        }
        Button("Search docs", type: "button", data-variant: "secondary", data-size: "sm") {
            style { display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 12px; border-radius: $radius-sm; border: 1px solid $line-strong; background: $surface-raised; color: $text-primary; font: 600 12px/1.2 $font-sans; cursor: pointer
                    &:hover { background: $surface-hover; border-color: $border-control }  @media (max-width: 768px) { display: none } }
            on click {
                UiStore.open("palette")
            }
            Kbd(text: "/")
        }
    }

    Row {
        style { flex-wrap: nowrap; align-items: flex-start; gap: 0; max-width: 1440px; margin: 0 auto; width: 100%; @media (max-width: 1024px) { flex-wrap: wrap } }
        // Nav tree
        Stack(role: "navigation", aria-label: "Documentation") {
            style { width: 272px; flex: none; border-right: 1px solid $line-hairline; padding: 32px 20px 64px 80px; gap: 0; position: sticky; top: 120px
                    @media (max-width: 1024px) { width: 100%; position: static; border-right: 0; border-bottom: 1px solid $line-hairline; padding: 24px 32px }  @media (max-width: 768px) { padding: 16px } }
            TreeSection(name: "Start", count: "4", open: openStart, items: ContentStore.docsTree[0].items, current: "Routing rules") { on click { openStart = !openStart } }
            TreeSection(name: "Runtime", count: "6", open: openRuntime, items: ContentStore.docsTree[1].items, current: "Routing rules") { on click { openRuntime = !openRuntime } }
            TreeSection(name: "Builds", count: "4", open: openBuilds, items: ContentStore.docsTree[2].items, current: "Routing rules") { on click { openBuilds = !openBuilds } }
            TreeSection(name: "Operate", count: "4", open: openOperate, items: ContentStore.docsTree[3].items, current: "Routing rules") { on click { openOperate = !openOperate } }
            TreeSection(name: "Reference", count: "4", open: openReference, items: ContentStore.docsTree[4].items, current: "Routing rules") { on click { openReference = !openReference } }
        }

        // Prose
        Stack {
            style { flex-grow: 1; min-width: 0; padding: 40px 48px 72px; gap: 0; @media (max-width: 768px) { padding: 24px 16px 48px } }
            Container { style { padding: 0 0 14px; width: auto }  Overline(text: "RUNTIME") }
            Heading("Routing rules").h1 { style { margin: 0 0 20px; font-size: 44px; line-height: 1.1; letter-spacing: -0.02em; font-weight: 700; @media (max-width: 768px) { font-size: 32px } } }
            Lead(text: "A routing rule decides which build or function answers a request. Rules live in your repository, ship inside the artifact, and are evaluated at the edge before anything of yours runs.")
            Row { style { gap: 8px; margin: 24px 0 8px }
                StatusBadge(label: "Stable since v9", tone: "success", dot: false)
                StatusBadge(label: "Edge only", tone: "info", dot: false)
                StatusBadge(label: "2 ms budget", tone: "brass", dot: false) }

            ProseHeading(text: "The match object", id: "match")
            Prose(text: "Every rule is { match, target }. The match object is a conjunction: each key you set must be satisfied, and keys you omit are not consulted. A rule with an empty match is the fallback and must be last.")
            Stack {
                style { gap: 0; margin: 28px 0 32px; background: $surface-sunken; border: 1px solid $line-default; border-radius: $radius-md; overflow: hidden }
                Row(align: .center) {
                    style { flex-wrap: nowrap; gap: 4px; padding: 8px 8px 0; border-bottom: 1px solid $line-hairline }
                    Row(role: "tablist", aria-label: "Route definition format", align: .center) {
                        style { flex-wrap: nowrap; gap: 4px; flex-grow: 1 }
                        CodeTab(label: "routes.halyard.ts", selected: code == "ts") { on click { code = "ts" } }
                        CodeTab(label: "routes.json", selected: code == "json") { on click { code = "json" } }
                        CodeTab(label: "CLI", selected: code == "cli") { on click { code = "cli" } }
                    }
                    IconBtn(icon: "copy", label: "Copy snippet", size: 34) { on click { navigator.clipboard.writeText(codeText) } }
                }
                Code("{codeText}").block { style { display: block; margin: 0; padding: 20px 22px; font-family: $font-mono; font-size: 13px; line-height: 1.75; color: $text-secondary; white-space: pre-wrap; background: transparent; border: 0 } }
            }
            Callout(tone: "info", title: "Rules are part of the build", body: "Changing a rule produces a new artifact and a new hash. That is deliberate: it means a rollback restores the routing that shipped with the code, not whatever the dashboard happened to say at the time.")

            ProseHeading(text: "Evaluation order", id: "order")
            Prose(text: "Rules are read top to bottom and the first match answers. There is no scoring and no specificity system to learn: if two rules could both match, the one written first wins. The CLI refuses a deploy where a later rule is unreachable.")
            List.ordered {
                style { margin: 0 0 20px; padding-left: 24px; color: $text-secondary; font-size: 16px; line-height: 1.7; max-width: 72ch }
                List.Item { style { margin: 0 0 8px; padding: 0; display: list-item }  Text("Cookie and header rules, because they are the narrowest.") { style { margin: 0; font-size: 16px; color: $text-secondary } } }
                List.Item { style { margin: 0 0 8px; padding: 0; display: list-item }  Text("Geo rules, which only choose a preferred region.") { style { margin: 0; font-size: 16px; color: $text-secondary } } }
                List.Item { style { margin: 0 0 8px; padding: 0; display: list-item }  Text("Path rules that send traffic to a function.") { style { margin: 0; font-size: 16px; color: $text-secondary } } }
                List.Item { style { margin: 0 0 8px; padding: 0; display: list-item }  Text("The fallback, which is always a build hash.") { style { margin: 0; font-size: 16px; color: $text-secondary } } }
            }

            ProseHeading(text: "Targets", id: "targets")
            Prose(text: "A rule sends the request to exactly one of three things: a build, an edge fn, or a preferred region. A region target does not answer the request; it only reorders which region is asked first, and the next rule still applies.")
            Callout(tone: "warning", title: "Weighted rules must sum to 100", body: "If you split traffic with weight, every rule in that group has to add up to exactly 100. A group that sums to 99 or 101 fails the deploy with HL-4021 rather than silently sending the remainder to the fallback.")

            ProseHeading(text: "Computed rules", id: "compute")
            Prose(text: "When a header comparison is not enough, match.fn takes a pure function that receives the request and returns a boolean. It runs inside a 2 ms budget on the same isolate that will serve the request, so it has no network and no KV access. Throwing counts as no match and is recorded on the trace.")

            ProseHeading(text: "Rule parameters", id: "params")
            Container { style { border: 1px solid $line-default; border-radius: $radius-md; overflow: auto; padding: 0; width: 100%; max-width: 100%; margin: 0 0 20px }
                Table(caption: "Routing rule parameters, their types and defaults") {
                    style { width: 100%; border-collapse: collapse; font: 400 14px/1.55 $font-sans; min-width: 560px }
                    Table.Head { Table.Row { Th(text: "Key")  Th(text: "Type")  Th(text: "Default")  Th(text: "Notes") } }
                    Table.Body {
                        for p in ContentStore.ruleParams {
                            Table.Row { style { &:hover { background: $surface-hover } }
                                Td(text: p.key, mono: true, color: "var(--text-accent)")
                                Td(text: p.type, mono: true, color: "var(--text-secondary)")
                                Td(text: p.def, mono: true, color: "var(--text-tertiary)")
                                Td(text: p.note) }
                        }
                    }
                }
            }

            ProseHeading(text: "What goes wrong", id: "errors")
            Prose(text: "Three errors account for most refused deploys. Each one is reported with the rule index and the line in your source, before anything is uploaded.")
            Stack { style { gap: 8px; margin: 0 0 20px }
                for e in ContentStore.ruleErrors {
                    Row(align: .baseline) { style { flex-wrap: nowrap; gap: 14px; padding: 12px 14px; border: 1px solid $line-hairline; border-radius: $radius-sm; background: $surface-inset }
                        Num(text: e.code, size: "13px", color: "var(--text-danger)")
                        Text(e.text) { style { margin: 0; font-size: 14px; color: $text-secondary } } }
                }
            }

            Grid(columns: 2) { style { gap: 16px; margin-top: 40px; @media (max-width: 480px) { grid-template-columns: 1fr } }
                Link(to: "/docs") {
                    style { display: block; padding: 18px 20px; border: 1px solid $line-default; border-radius: $radius-md; background: $surface-raised; text-decoration: none; color: $text-primary
                            transition: border-color $d-base $ease-standard, transform $d-base $ease-standard; &:hover { border-color: $line-strong; transform: translateY(-2px) } }
                    Overline(text: "PREVIOUS")
                    Text("Edge functions") { style { margin: 8px 0 0; font: 700 15px/1.3 $font-sans; color: $text-primary } } }
                Link(to: "/docs") {
                    style { display: block; padding: 18px 20px; border: 1px solid $line-default; border-radius: $radius-md; background: $surface-raised; text-decoration: none; color: $text-primary; text-align: right
                            transition: border-color $d-base $ease-standard, transform $d-base $ease-standard; &:hover { border-color: $line-strong; transform: translateY(-2px) } }
                    Overline(text: "NEXT")
                    Text("Middleware") { style { margin: 8px 0 0; font: 700 15px/1.3 $font-sans; color: $text-primary } } }
            }
        }

        // On this page
        Stack(role: "navigation", aria-label: "On this page") {
            style { width: 232px; flex: none; padding: 40px 80px 64px 0; gap: 12px; position: sticky; top: 120px; @media (max-width: 1024px) { display: none } }
            Overline(text: "ON THIS PAGE")
            Stack { style { gap: 0 }
                for t in ContentStore.docsToc {
                    if toc == t.id {
                        Link(t.label, to: "/docs", aria-current: "true") { style { display: block; padding: 5px 0 5px 14px; border-left: 2px solid $brand; font: 400 13px/1.45 $font-sans; color: $text-primary; text-decoration: none } on click { toc = t.id } }
                    } else {
                        Link(t.label, to: "/docs") { style { display: block; padding: 5px 0 5px 14px; border-left: 2px solid $line-hairline; font: 400 13px/1.45 $font-sans; color: $text-tertiary; text-decoration: none; &:hover { color: $text-primary; border-color: $line-strong } } on click { toc = t.id } }
                    }
                }
            }
            Rule
            FlButton(label: "Try it in the editor", variant: "ghost", size: "sm", to: "/app/editor")
            FlButton(label: "Edit this page", variant: "ghost", size: "sm", to: "/docs")
        }
    }

    SiteFooter
}
