page AppExplorer(path: "/app/explorer", title: "Explorer", description: "Query traces, logs and builds with filters you can add and remove.", noindex: true, layout: AppShell(crumb: "Explorer")) {
    use ExplorerStore

    SrTitle(text: "Explorer")
    Row(align: .stretch) {
        style { flex-wrap: nowrap; gap: 0; align-items: stretch; flex-grow: 1; @media (max-width: 1024px) { flex-wrap: wrap } }
        // Saved queries rail
        Stack { style { width: 260px; flex: none; gap: 0; border-right: 1px solid $line-hairline; background: $surface-sunken; padding: 18px 12px; @media (max-width: 1024px) { width: 100%; border-right: 0; border-bottom: 1px solid $line-hairline } }
            Row(align: .center) { style { gap: 8px; padding: 0 12px 12px; flex-wrap: nowrap }
                Container { style { flex-grow: 1; padding: 0; width: auto }  Overline(text: "SAVED QUERIES") }
                IconBtn(icon: "plus", label: "New query", size: 26) }
            Stack(role: "group", aria-label: "Saved queries") { style { gap: 2px; @media (max-width: 1024px) { flex-direction: row; flex-wrap: wrap } }
                for s in ExplorerStore.savedRows by s.id { SavedQuery(name: s.name, meta: s.meta, current: s.current) { on click { ExplorerStore.pickSaved(s.id) } } } }
            Container { style { margin: auto 0 0; padding: 14px 12px 0; border-top: 1px solid $line-hairline; width: auto; @media (max-width: 1024px) { display: none } }
                Text("A saved query is a file in the repository too. Editing one here writes a diff you commit like anything else.") { style { margin: 0; font-size: 12px; line-height: 1.6; color: $text-tertiary } } }
        }

        Stack { style { flex-grow: 1; min-width: 0; gap: 0; flex-basis: 0; @media (max-width: 1024px) { flex-basis: 100% } }
            // Builder
            Stack { style { gap: 16px; padding: 20px 28px; border-bottom: 1px solid $line-hairline; @media (max-width: 768px) { padding: 16px } }
                Row(align: .end) { style { gap: 14px; flex-wrap: wrap; align-items: flex-end }
                    Container { style { width: 180px; padding: 0; @media (max-width: 480px) { width: 100% } }
                        Select(id: "ex-src", label: "Source", value: ExplorerStore.source) { on change(event) { ExplorerStore.setSource(event.target.value) }  Select.Option("traces", value: "traces")  Select.Option("logs", value: "logs")  Select.Option("builds", value: "builds") } }
                    Container { style { width: 180px; padding: 0; @media (max-width: 480px) { width: 100% } }
                        Select(id: "ex-range", label: "Time range") { Select.Option("Last 24 hours", value: "24h")  Select.Option("Last hour", value: "1h")  Select.Option("Last 7 days", value: "7d")  Select.Option("Custom…", value: "custom") } }
                    Container { style { width: 200px; padding: 0; @media (max-width: 480px) { width: 100% } }
                        Select(id: "ex-group", label: "Group by") { Select.Option("region, route", value: "region-route")  Select.Option("region", value: "region")  Select.Option("route", value: "route")  Select.Option("build", value: "build") } }
                    Container { style { width: 180px; padding: 0; @media (max-width: 480px) { width: 100% } }
                        Select(id: "ex-agg", label: "Measure") { Select.Option("count, p50, p99", value: "all")  Select.Option("count", value: "count")  Select.Option("p95 duration", value: "p95")  Select.Option("error rate", value: "errors") } }
                    Container { style { flex-grow: 1; padding: 0; width: auto } }
                    FlButton(label: ExplorerStore.runLabel, variant: "primary", icon: "check") { on click { ExplorerStore.run() } }
                }
                Stack { style { gap: 10px }
                    Overline(text: "FILTERS, ALL OF WHICH MUST MATCH")
                    Stack(role: "group", aria-label: "Filters") { style { gap: 8px; max-width: 900px }
                        for f in ExplorerStore.filterRows by f.id {
                            Row(align: .center) { style { gap: 10px; padding: 10px 12px; background: $surface-inset; border: 1px solid $line-hairline; border-radius: $radius-sm; flex-wrap: nowrap; @media (max-width: 768px) { flex-wrap: wrap } }
                                Num(text: f.n, size: "11px", color: "var(--text-disabled)", weight: "400")
                                Container { style { width: 180px; flex: none; padding: 0 }
                                  Select(id: f.fieldId, aria-label: "Field", value: ExplorerStore.fieldOf(f.id), class: "hl-mono hl-compact") {
                                    on change(event) { ExplorerStore.setField(f.id, event.target.value) }
                                    Select.Option("region", value: "region")  Select.Option("route", value: "route")  Select.Option("status", value: "status")  Select.Option("duration_ms", value: "duration_ms")  Select.Option("build", value: "build")  Select.Option("rule", value: "rule")  Select.Option("cold_start", value: "cold_start")  Select.Option("country", value: "country") } }
                                Container { style { width: 116px; flex: none; padding: 0 }
                                  Select(id: f.opId, aria-label: "Operator", value: ExplorerStore.opOf(f.id), class: "hl-compact") {
                                    on change(event) { ExplorerStore.setOp(f.id, event.target.value) }
                                    Select.Option("is", value: "is")  Select.Option("is not", value: "is not")  Select.Option("contains", value: "contains")  Select.Option(">", value: ">")  Select.Option("<", value: "<")  Select.Option("in", value: "in") } }
                                Container { style { flex-grow: 1; padding: 0; width: auto; min-width: 120px }
                                    Input(id: f.valId, value: ExplorerStore.valueOf(f.id), placeholder: "value", aria-label: "Value", class: "hl-mono hl-compact").text { on input(event) { ExplorerStore.setValue(f.id, event.target.value) } } }
                                IconBtn(icon: "close", label: f.removeLabel, size: 30) { on click { ExplorerStore.removeFilter(f.id) } }
                            }
                        }
                        Row { style { gap: 10px }
                            FlButton(label: "Add filter", variant: "secondary", size: "sm", icon: "plus") { on click { ExplorerStore.addFilter() } }
                            if ExplorerStore.hasFilters { FlButton(label: "Remove all", variant: "ghost", size: "sm") { on click { ExplorerStore.clearFilters() } } } }
                    }
                }
                Row(align: .center) { style { gap: 12px; padding: 12px 14px; background: $surface-sunken; border: 1px solid $line-hairline; border-radius: $radius-sm; flex-wrap: nowrap }
                    Overline(text: "HQL")
                    Code("{ExplorerStore.hql}") { style { flex-grow: 1; min-width: 0; font: 400 12.5px/1.5 $font-mono; color: $text-accent; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: transparent; padding: 0; border: 0 } }
                    FlButton(label: "Copy", variant: "ghost", size: "sm", icon: "copy") { on click { navigator.clipboard.writeText(ExplorerStore.hql) } } }
            }

            // Results
            Stack { style { gap: 14px; padding: 18px 28px 24px; flex-grow: 1; @media (max-width: 768px) { padding: 16px } }
                Row(align: .center) { style { gap: 14px; flex-wrap: wrap }
                    Text("{ExplorerStore.resultNote}", role: "status") { style { margin: 0; font-size: 13px; color: $text-tertiary; flex-grow: 1 } }
                    SegGroup(label: "Result view") {
                        SegButton(label: "Table", pressed: ExplorerStore.isTable) { on click { ExplorerStore.setView("table") } }
                        SegButton(label: "Bar chart", pressed: ExplorerStore.isChart) { on click { ExplorerStore.setView("chart") } } }
                    FlButton(label: "Export", variant: "secondary", size: "sm", icon: "download") }
                if ExplorerStore.isTable {
                    Container { style { border: 1px solid $line-default; border-radius: $radius-md; overflow: auto; padding: 0; width: 100%; max-width: 100% }
                        Table(caption: "Query result grouped by region and route") {
                            style { width: 100%; border-collapse: collapse; font: 400 14px/1.55 $font-sans; min-width: 640px }
                            Table.Head { Table.Row { Th(text: "Region")  Th(text: "Route")  Th(text: "Requests", numeric: true)  Th(text: "p50 ms", numeric: true)  Th(text: "p99 ms", numeric: true)  Th(text: "Share %", numeric: true) } }
                            Table.Body {
                                for r in ExplorerStore.rows by r.label {
                                    Table.Row {
                                        Td(text: r.region, mono: true, color: "var(--text-primary)")
                                        Td(text: r.route, mono: true, color: "var(--text-secondary)")
                                        Td(text: r.n, numeric: true)
                                        Td(text: r.p50, numeric: true)
                                        Td(text: r.p99, numeric: true, color: r.p99Color)
                                        Td(text: r.share, numeric: true) }
                                } } } }
                }
                if ExplorerStore.isChart {
                    Stack { style { gap: 18px; border: 1px solid $line-default; border-radius: $radius-md; padding: 22px 26px; background: $surface-raised }
                        Text("Requests per region and route. One series, so every bar carries its own value and there is no legend.") { style { margin: 0; font-size: 13px; color: $text-tertiary } }
                        Stack { style { gap: 12px }
                            for r in ExplorerStore.rows by r.label {
                                Row(align: .center) { style { gap: 14px; flex-wrap: nowrap }
                                    Text(r.label) { style { margin: 0; width: 190px; flex: none; font: 400 12px/1.3 $font-mono; color: $text-secondary; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; @media (max-width: 480px) { width: 120px } } }
                                    Container(role: "img", aria-label: "{r.label} {r.n} requests") { style { flex-grow: 1; height: 20px; background: $surface-inset; border-radius: 3px; padding: 0; margin: 0; width: auto; min-width: 0; overflow: hidden }
                                        Container { style { width: {r.width}; height: 100%; background: {r.color}; border-radius: 0 4px 4px 0; padding: 0; margin: 0; transition: width $d-base $ease-standard } } }
                                    Container { style { width: 62px; flex: none; text-align: right; padding: 0; margin: 0 }  Num(text: r.n, size: "12px", color: "var(--text-primary)", weight: "500") } }
                            } } }
                }
            }
        }
    }
}
