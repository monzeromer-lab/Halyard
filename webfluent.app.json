{
  "name": "Halyard",
  "version": "1.0.0",
  "author": "",
  "theme": {
    "name": "FluantInk",
    "builtin": "structural"
  },
  "build": {
    "output": "./build",
    "minify": true,
    "ssg": true,
    "base_path": "/Halyard",
    "csp": true,
    "budget": {
      "app.js": "60 kB",
      "styles.css": "14 kB"
    }
  },
  "dev": {
    "port": 3000
  },
  "meta": {
    "title": "Halyard",
    "favicon": "/favicon.svg",
    "site_url": "https://monzeromer-lab.github.io/Halyard",
    "site_name": "Halyard",
    "description": "An edge runtime that treats a deploy as a routing change.",
    "lang": "en",
    "sitemap": true,
    "fonts": [
      "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=JetBrains+Mono:wght@400..600&family=Manrope:wght@400..800&display=swap"
    ]
  }
}
